{
 "description": "Cloud provider cases written from the providers' documentation (dev-docs/plans/KEEPFIN-CLOUD-SPEC.md); expected values were reviewed by hand. Not recordings of live services.",
 "cases": [
  {
   "name": "pkce from random bytes",
   "provider": "drive",
   "op": "pkce",
   "input": {
    "randomHex": "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
   },
   "expected": {
    "verifier": "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8",
    "challenge": "6oZqdX5MOLq_qBJ8vppAnT4fk6AP8UiP9zX8-Rev_9A",
    "method": "S256"
   }
  },
  {
   "name": "rfc7636 appendix B challenge",
   "provider": "drive",
   "op": "pkceChallenge",
   "input": {
    "verifier": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
   },
   "expected": {
    "challenge": "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM",
    "method": "S256"
   }
  },
  {
   "name": "drive auth url",
   "provider": "drive",
   "op": "authUrl",
   "input": {
    "clientId": "CID",
    "redirectUri": "http://127.0.0.1:5555/callback",
    "state": "ST",
    "codeChallenge": "CH"
   },
   "expected": {
    "url": "https://accounts.google.com/o/oauth2/v2/auth?client_id=CID&response_type=code&redirect_uri=http%3A%2F%2F127.0.0.1%3A5555%2Fcallback&scope=https%3A%2F%2Fwww.googleapis.com%2Fauth%2Fdrive.file&state=ST&code_challenge=CH&code_challenge_method=S256&access_type=offline&prompt=consent"
   }
  },
  {
   "name": "graph auth url",
   "provider": "graph",
   "op": "authUrl",
   "input": {
    "clientId": "CID",
    "redirectUri": "http://127.0.0.1:5555/callback",
    "state": "ST",
    "codeChallenge": "CH"
   },
   "expected": {
    "url": "https://login.microsoftonline.com/consumers/oauth2/v2.0/authorize?client_id=CID&response_type=code&redirect_uri=http%3A%2F%2F127.0.0.1%3A5555%2Fcallback&scope=Files.ReadWrite.AppFolder%20offline_access&state=ST&code_challenge=CH&code_challenge_method=S256&response_mode=query"
   }
  },
  {
   "name": "dropbox auth url",
   "provider": "dropbox",
   "op": "authUrl",
   "input": {
    "clientId": "CID",
    "redirectUri": "http://127.0.0.1:5555/callback",
    "state": "ST",
    "codeChallenge": "CH"
   },
   "expected": {
    "url": "https://www.dropbox.com/oauth2/authorize?client_id=CID&response_type=code&redirect_uri=http%3A%2F%2F127.0.0.1%3A5555%2Fcallback&scope=files.content.read%20files.content.write%20files.metadata.read%20account_info.read&state=ST&code_challenge=CH&code_challenge_method=S256&token_access_type=offline"
   }
  },
  {
   "name": "drive token request",
   "provider": "drive",
   "op": "tokenRequest",
   "input": {
    "clientId": "CID",
    "redirectUri": "http://127.0.0.1:5555/callback",
    "code": "c o/de",
    "verifier": "V"
   },
   "expected": {
    "request": {
     "method": "POST",
     "url": "https://oauth2.googleapis.com/token",
     "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
     },
     "auth": false,
     "body": "grant_type=authorization_code&code=c%20o%2Fde&redirect_uri=http%3A%2F%2F127.0.0.1%3A5555%2Fcallback&client_id=CID&code_verifier=V"
    }
   }
  },
  {
   "name": "graph refresh request",
   "provider": "graph",
   "op": "refreshRequest",
   "input": {
    "clientId": "CID",
    "refreshToken": "RT"
   },
   "expected": {
    "request": {
     "method": "POST",
     "url": "https://login.microsoftonline.com/consumers/oauth2/v2.0/token",
     "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
     },
     "auth": false,
     "body": "grant_type=refresh_token&refresh_token=RT&client_id=CID&scope=Files.ReadWrite.AppFolder%20offline_access"
    }
   }
  },
  {
   "name": "dropbox refresh request",
   "provider": "dropbox",
   "op": "refreshRequest",
   "input": {
    "clientId": "CID",
    "refreshToken": "RT"
   },
   "expected": {
    "request": {
     "method": "POST",
     "url": "https://api.dropboxapi.com/oauth2/token",
     "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
     },
     "auth": false,
     "body": "grant_type=refresh_token&refresh_token=RT&client_id=CID"
    }
   }
  },
  {
   "name": "drive revoke",
   "provider": "drive",
   "op": "revokeRequest",
   "input": {
    "token": "T"
   },
   "expected": {
    "request": {
     "method": "POST",
     "url": "https://oauth2.googleapis.com/revoke",
     "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
     },
     "auth": false,
     "body": "token=T"
    }
   }
  },
  {
   "name": "dropbox revoke",
   "provider": "dropbox",
   "op": "revokeRequest",
   "input": {},
   "expected": {
    "request": {
     "method": "POST",
     "url": "https://api.dropboxapi.com/2/auth/token/revoke",
     "headers": {},
     "auth": true
    }
   }
  },
  {
   "name": "graph has no revoke",
   "provider": "graph",
   "op": "revokeRequest",
   "input": {},
   "expected": {
    "request": null,
    "reason": "The provider has no revocation endpoint; the grant is removed in the account settings."
   }
  },
  {
   "name": "token expiry from expires_in",
   "provider": "drive",
   "op": "parseToken",
   "input": {
    "response": {
     "status": 200,
     "headers": {},
     "body": "{\"access_token\":\"AT\",\"expires_in\":3599,\"refresh_token\":\"RT\",\"scope\":\"s\",\"token_type\":\"Bearer\"}"
    },
    "nowMs": 1792065600000
   },
   "expected": {
    "ok": true,
    "accessToken": "AT",
    "refreshToken": "RT",
    "expiresAtMs": 1792069199000,
    "scope": "s",
    "tokenType": "Bearer"
   }
  },
  {
   "name": "refresh keeps the old refresh token",
   "provider": "dropbox",
   "op": "parseToken",
   "input": {
    "response": {
     "status": 200,
     "headers": {},
     "body": "{\"access_token\":\"AT2\",\"expires_in\":14400,\"token_type\":\"bearer\"}"
    },
    "nowMs": 1792065600000,
    "previousRefreshToken": "RT"
   },
   "expected": {
    "ok": true,
    "accessToken": "AT2",
    "refreshToken": "RT",
    "expiresAtMs": 1792080000000,
    "tokenType": "bearer"
   }
  },
  {
   "name": "revoked grant",
   "provider": "drive",
   "op": "parseToken",
   "input": {
    "response": {
     "status": 400,
     "headers": {},
     "body": "{\"error\":\"invalid_grant\",\"error_description\":\"Token has been expired or revoked.\"}"
    }
   },
   "expected": {
    "ok": false,
    "error": {
     "kind": "NeedsSignIn",
     "status": 400,
     "code": "invalid_grant",
     "message": "Token has been expired or revoked.",
     "refresh": false
    }
   }
  },
  {
   "name": "microsoft refresh expired",
   "provider": "graph",
   "op": "parseToken",
   "input": {
    "response": {
     "status": 400,
     "headers": {},
     "body": "{\"error\":\"invalid_grant\",\"error_description\":\"AADSTS70008\"}"
    }
   },
   "expected": {
    "ok": false,
    "error": {
     "kind": "NeedsSignIn",
     "status": 400,
     "code": "invalid_grant",
     "message": "AADSTS70008",
     "refresh": false
    }
   }
  },
  {
   "name": "callback ok",
   "provider": "drive",
   "op": "parseCallback",
   "input": {
    "url": "http://127.0.0.1:5555/callback?code=4%2F0abc&state=ST",
    "expectedState": "ST"
   },
   "expected": {
    "ok": true,
    "code": "4/0abc"
   }
  },
  {
   "name": "callback wrong state",
   "provider": "drive",
   "op": "parseCallback",
   "input": {
    "url": "http://127.0.0.1:5555/callback?code=x&state=OTHER",
    "expectedState": "ST"
   },
   "expected": {
    "ok": false,
    "reason": "state-mismatch"
   }
  },
  {
   "name": "callback denied",
   "provider": "drive",
   "op": "parseCallback",
   "input": {
    "url": "http://127.0.0.1:5555/callback?error=access_denied&state=ST",
    "expectedState": "ST"
   },
   "expected": {
    "ok": false,
    "reason": "denied",
    "error": "access_denied"
   }
  }
 ]
}