{
 "description": "Cloud provider cases written from the providers' documentation (dev-docs/plans/KEEPFIN-CLOUD-SPEC.md); expected values were reviewed by hand. Not recordings of live services.",
 "cases": [
  {
   "name": "list",
   "provider": "webdav",
   "op": "list",
   "input": {
    "base": "https://dav.example.com/remote.php/dav/files/me",
    "folder": {
     "path": "Keepfin/Café ♫"
    }
   },
   "expected": {
    "request": {
     "method": "PROPFIND",
     "url": "https://dav.example.com/remote.php/dav/files/me/Keepfin/Caf%C3%A9%20%E2%99%AB/",
     "headers": {
      "Content-Type": "application/xml; charset=utf-8",
      "Depth": "1"
     },
     "auth": true,
     "body": "<?xml version=\"1.0\" encoding=\"utf-8\"?><d:propfind xmlns:d=\"DAV:\"><d:prop><d:resourcetype/><d:getcontentlength/><d:getetag/><d:getlastmodified/></d:prop></d:propfind>"
    }
   }
  },
  {
   "name": "parse list",
   "provider": "webdav",
   "op": "parseList",
   "input": {
    "response": {
     "status": 207,
     "headers": {},
     "body": "<?xml version=\"1.0\"?><d:multistatus xmlns:d=\"DAV:\"><d:response><d:href>/remote.php/dav/files/me/Keepfin/</d:href><d:propstat><d:prop><d:resourcetype><d:collection/></d:resourcetype></d:prop><d:status>HTTP/1.1 200 OK</d:status></d:propstat></d:response><d:response><d:href>/remote.php/dav/files/me/Keepfin/a%20b.mp3</d:href><d:propstat><d:prop><d:resourcetype/><d:getcontentlength>42</d:getcontentlength><d:getetag>\"abc\"</d:getetag><d:getlastmodified>Wed, 15 Oct 2026 12:00:00 GMT</d:getlastmodified></d:prop><d:status>HTTP/1.1 200 OK</d:status></d:propstat></d:response><d:response><d:href>/remote.php/dav/files/me/Keepfin/sub/</d:href><d:propstat><d:prop><d:resourcetype><d:collection/></d:resourcetype></d:prop><d:status>HTTP/1.1 200 OK</d:status></d:propstat></d:response><d:response><d:href>/remote.php/dav/files/me/Keepfin/locked.bin</d:href><d:status>HTTP/1.1 403 Forbidden</d:status></d:response></d:multistatus>"
    },
    "base": "https://dav.example.com/remote.php/dav/files/me",
    "folder": "Keepfin"
   },
   "expected": {
    "ok": true,
    "entries": [
     {
      "name": "a b.mp3",
      "folder": false,
      "size": 42,
      "mtimeMs": 1792065600000,
      "etag": "\"abc\"",
      "hashes": {},
      "path": "Keepfin/a b.mp3"
     },
     {
      "name": "sub",
      "folder": true,
      "hashes": {},
      "path": "Keepfin/sub"
     }
    ],
    "nextCursor": null,
    "incomplete": true,
    "failed": [
     "Keepfin/locked.bin"
    ]
   }
  },
