  {
   "name": "replace needs the probe",
   "provider": "webdav",
   "op": "replaceSmall",
   "input": {
    "base": "https://dav.example.com/remote.php/dav/files/me",
    "ref": {
     "path": "a"
    },
    "etag": "\"1\"",
    "content": "x"
   },
   "expected": {
    "unsupported": true,
    "reason": "The probe did not prove that this server honours If-Match"
   }
  },
  {
   "name": "replace after the probe",
   "provider": "webdav",
   "op": "replaceSmall",
   "input": {
    "base": "https://dav.example.com/remote.php/dav/files/me",
    "cas": true,
    "ref": {
     "path": "a"
    },
    "etag": "\"1\"",
    "content": "x"
   },
   "expected": {
    "request": {
     "method": "PUT",
     "url": "https://dav.example.com/remote.php/dav/files/me/a",
