  {
   "name": "probe passes",
   "provider": "webdav",
   "op": "probeEvaluate",
   "input": {
    "put": {
     "status": 201,
     "etag": "\"v1\""
    },
    "wrongMatch": {
     "status": 412
    },
    "rightMatch": {
     "status": 204
    },
    "range": {
     "status": 206
    },
    "noneMatch": {
     "status": 412
    },
    "moveOver": {
     "status": 412
    }
   },
   "expected": {
    "cas": true,
    "range": true,
    "createOnly": true,
    "noReplaceMove": true,
    "strongEtag": true,
    "ifMatchIgnored": false,
    "reason": "ok"
   }
  },
  {
   "name": "probe: the local test server (ignores If-Match and If-None-Match, honours Overwrite: F)",
   "provider": "webdav",
   "op": "probeEvaluate",
   "input": {
    "put": {
     "status": 201,
     "etag": "\"58c38c46\""
    },
    "wrongMatch": {
     "status": 200
    },
    "rightMatch": {
     "status": 200
    },
    "range": {
     "status": 206
    },
    "noneMatch": {
     "status": 200
    },
    "moveOver": {
     "status": 412
    }
   },
   "expected": {
    "cas": false,
    "range": true,
    "createOnly": false,
    "noReplaceMove": true,
    "strongEtag": true,
    "ifMatchIgnored": true,
    "reason": "The server ignored a wrong If-Match: no safe overwrite or delete"
   }
  },
  {
   "name": "probe: no-replace move and create-only requests",
   "provider": "webdav",
   "op": "probeMoveOver",
   "input": {
    "base": "https://dav.example.com/remote.php/dav/files/me",
    "path": "Keepfin/.keepfin/probe-a",
    "path2": "Keepfin/.keepfin/probe-b"
   },
   "expected": {
    "request": {
     "method": "MOVE",
     "url": "https://dav.example.com/remote.php/dav/files/me/Keepfin/.keepfin/probe-a",
