  {
   "name": "move never overwrites",
   "provider": "webdav",
   "op": "move",
   "input": {
    "base": "https://dav.example.com/remote.php/dav/files/me",
    "ref": {
     "path": "a/b"
    },
    "toPath": "Keepfin/.keepfin/trash/b-1"
   },
   "expected": {
    "request": {
     "method": "MOVE",
     "url": "https://dav.example.com/remote.php/dav/files/me/a/b",
     "headers": {
      "Destination": "https://dav.example.com/remote.php/dav/files/me/Keepfin/.keepfin/trash/b-1",
      "Overwrite": "F"
     },
     "auth": true
    }
   }
  },
  {
   "name": "download range",
   "provider": "webdav",
   "op": "download",
   "input": {
    "base": "https://dav.example.com/remote.php/dav/files/me",
    "ref": {
     "path": "a/b"
    },
    "start": 10,
    "end": 19
   },
   "expected": {
    "request": {
     "method": "GET",
     "url": "https://dav.example.com/remote.php/dav/files/me/a/b",
     "headers": {
      "Range": "bytes=10-19"
     },
     "auth": true
    }
   }
  },
  {
