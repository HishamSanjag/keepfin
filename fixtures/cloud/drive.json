    }
   }
  },
  {
   "name": "error 503 is not throttling",
   "provider": "drive",
   "op": "parseDone",
   "input": {
    "response": {
     "status": 503,
     "headers": {},
     "body": ""
    }
   },
   "expected": {
    "ok": false,
    "error": {
     "kind": "Transient",
     "status": 503
    }
   }
  },
  {
   "name": "error 404",
   "provider": "drive",
   "op": "parseDone",
   "input": {
    "response": {
     "status": 404,
     "headers": {},
     "body": "{\"error\":{\"code\":404}}"
    }
   },
   "expected": {
    "ok": false,
    "error": {
     "kind": "NotFound",
     "status": 404
    }
   }
  }
 ]
}