  {
   "name": "upload 308 with Range",
   "provider": "drive",
   "op": "parseUploadAppend",
   "input": {
    "response": {
     "status": 308,
     "headers": {
      "range": "bytes=0-8388607"
     },
     "body": ""
    }
   },
   "expected": {
    "ok": true,
    "done": false,
    "nextOffset": 8388608
   }
  },
  {
   "name": "upload 308 nothing yet",
   "provider": "drive",
   "op": "parseUploadQuery",
   "input": {
    "response": {
     "status": 308,
     "headers": {},
     "body": ""
    }
   },
   "expected": {
    "ok": true,
    "done": false,
    "nextOffset": 0
   }
  },
  {
   "name": "upload done",
   "provider": "drive",
   "op": "parseUploadAppend",
   "input": {
    "response": {
     "status": 200,
     "headers": {},
     "body": "{\"id\":\"F9\",\"name\":\"a.mp3\",\"mimeType\":\"audio/mpeg\",\"size\":\"1234\",\"md5Checksum\":\"abc\",\"sha256Checksum\":\"def\",\"modifiedTime\":\"2026-10-15T12:00:00.500Z\",\"createdTime\":\"2026-10-14T00:00:00Z\",\"version\":\"7\",\"parents\":[\"P1\"]}"
    }
   },
   "expected": {
    "ok": true,
    "done": true,
    "entry": {
     "id": "F9",
     "name": "a.mp3",
     "folder": false,
     "size": 1234,
     "mtimeMs": 1792065600500,
     "createdMs": 1791936000000,
     "etag": "7",
     "hashes": {
      "sha256": "def",
      "md5": "abc"
     },
     "parentId": "P1"
    }
   }
  },
  {
   "name": "upload session gone",
   "provider": "drive",
   "op": "parseUploadAppend",
   "input": {
    "response": {
     "status": 404,
     "headers": {},
     "body": "{\"error\":{\"code\":404,\"message\":\"Not Found\"}}"
    }
   },
   "expected": {
    "ok": false,
    "error": {
     "kind": "NotFound",
     "status": 404,
     "code": "SessionExpired",
     "message": "Not Found"
    }
   }
  },
  {
   "name": "quota",
   "provider": "drive",
   "op": "parseQuota",
   "input": {
    "response": {
     "status": 200,
     "headers": {},
     "body": "{\"storageQuota\":{\"limit\":\"16106127360\",\"usage\":\"1073741824\"},\"user\":{\"emailAddress\":\"a@b.c\"}}"
    }
   },
   "expected": {
    "ok": true,
    "usedBytes": 1073741824,
    "totalBytes": 16106127360,
    "freeBytes": 15032385536,
    "account": "a@b.c"
   }
  },
  {
   "name": "quota unlimited",
   "provider": "drive",
   "op": "parseQuota",
   "input": {
    "response": {
     "status": 200,
     "headers": {},
     "body": "{\"storageQuota\":{\"usage\":\"5\"}}"
    }
   },
   "expected": {
    "ok": true,
    "usedBytes": 5
   }
  },
  {
