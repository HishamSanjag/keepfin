  {
   "name": "upload query",
   "provider": "drive",
   "op": "uploadQuery",
   "input": {
    "session": {
     "url": "https://www.googleapis.com/upload/drive/v3/files?uploadType=resumable&upload_id=U1"
    },
    "total": 20971520
   },
   "expected": {
    "request": {
     "method": "PUT",
