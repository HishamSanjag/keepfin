    }
   }
  },
  {
   "name": "error storage full",
   "provider": "drive",
   "op": "parseDone",
   "input": {
    "response": {
     "status": 403,
     "headers": {},
     "body": "{\"error\":{\"code\":403,\"errors\":[{\"reason\":\"storageQuotaExceeded\"}]}}"
    }
   },
   "expected": {
    "ok": false,
    "error": {
