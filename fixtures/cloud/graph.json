   },
   "expected": {
    "request": {
     "method": "PUT",
     "url": "https://graph.microsoft.com/v1.0/me/drive/items/G0:/x%20y.json:/content?@microsoft.graph.conflictBehavior=fail",
     "headers": {
      "Content-Type": "application/octet-stream"
     },
     "auth": true,
     "body": "{}"
