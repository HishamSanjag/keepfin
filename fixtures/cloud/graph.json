  {
   "name": "delete with eTag",
   "provider": "graph",
   "op": "deleteCas",
   "input": {
    "ref": {
     "id": "G1"
    },
    "etag": "\"{E1},2\""
   },
   "expected": {
    "request": {
     "method": "DELETE",
     "url": "https://graph.microsoft.com/v1.0/me/drive/items/G1",
     "headers": {
      "If-Match": "\"{E1},2\""
     },
     "auth": true
    }
   }
  },
  {
   "name": "move to trash",
   "provider": "graph",
   "op": "move",
   "input": {
    "ref": {
     "id": "G1"
    },
    "newParentId": "TR",
    "newName": "G1-old",
    "etag": "\"{E1},2\""
   },
   "expected": {
    "request": {
     "method": "PATCH",
     "url": "https://graph.microsoft.com/v1.0/me/drive/items/G1",
     "headers": {
      "Content-Type": "application/json",
      "If-Match": "\"{E1},2\""
     },
     "auth": true,
     "body": "{\"name\":\"G1-old\",\"parentReference\":{\"id\":\"TR\"}}"
    }
   }
  },
  {
   "name": "upload start create only",
