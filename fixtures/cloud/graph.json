{
 "description": "Cloud provider cases written from the providers' documentation (dev-docs/plans/KEEPFIN-CLOUD-SPEC.md); expected values were reviewed by hand. Not recordings of live services.",
 "cases": [
  {
   "name": "list root",
   "provider": "graph",
   "op": "list",
   "input": {
    "folder": {
     "path": ""
    }
   },
   "expected": {
    "request": {
     "method": "GET",
     "url": "https://graph.microsoft.com/v1.0/me/drive/special/approot/children?$top=200&$select=id,name,size,eTag,cTag,file,folder,fileSystemInfo,lastModifiedDateTime,createdDateTime,parentReference",
     "headers": {},
     "auth": true
    }
   }
  },
  {
   "name": "list path",
   "provider": "graph",
   "op": "list",
   "input": {
    "folder": {
     "path": "Keepfin/art"
    }
   },
   "expected": {
    "request": {
     "method": "GET",
     "url": "https://graph.microsoft.com/v1.0/me/drive/special/approot:/Keepfin/art:/children?$top=200&$select=id,name,size,eTag,cTag,file,folder,fileSystemInfo,lastModifiedDateTime,createdDateTime,parentReference",
     "headers": {},
     "auth": true
    }
   }
  },
  {
   "name": "list id",
   "provider": "graph",
   "op": "list",
   "input": {
    "folder": {
     "id": "G0"
    }
   },
   "expected": {
    "request": {
     "method": "GET",
     "url": "https://graph.microsoft.com/v1.0/me/drive/items/G0/children?$top=200&$select=id,name,size,eTag,cTag,file,folder,fileSystemInfo,lastModifiedDateTime,createdDateTime,parentReference",
     "headers": {},
     "auth": true
    }
   }
  },
  {
   "name": "list next link",
   "provider": "graph",
   "op": "list",
   "input": {
    "folder": {
     "id": "G0"
    },
    "cursor": "https://graph.microsoft.com/v1.0/me/drive/items/G0/children?$skiptoken=abc"
   },
   "expected": {
    "request": {
     "method": "GET",
     "url": "https://graph.microsoft.com/v1.0/me/drive/items/G0/children?$skiptoken=abc",
     "headers": {},
     "auth": true
    }
   }
  },
  {
   "name": "list next link elsewhere is refused",
   "provider": "graph",
   "op": "list",
   "input": {
    "folder": {
     "id": "G0"
    },
    "cursor": "https://evil.example/x"
   },
   "expected": {
    "throws": true
   }
  },
  {
   "name": "parse list",
   "provider": "graph",
   "op": "parseList",
   "input": {
    "response": {
     "status": 200,
     "headers": {},
     "body": "{\"value\":[{\"id\":\"G1\",\"name\":\"a.mp3\",\"size\":99,\"eTag\":\"\\\"{E1},2\\\"\",\"cTag\":\"c\",\"file\":{\"hashes\":{\"quickXorHash\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAA=\"}},\"fileSystemInfo\":{\"lastModifiedDateTime\":\"2026-10-15T12:00:00Z\"},\"parentReference\":{\"id\":\"PP\"}},{\"id\":\"G2\",\"name\":\"sub\",\"folder\":{\"childCount\":1}},{\"id\":\"G3\",\"name\":\"gone\",\"deleted\":{}}],\"@odata.nextLink\":\"https://graph.microsoft.com/v1.0/x?$skiptoken=2\"}"
    }
   },
   "expected": {
    "ok": true,
    "entries": [
     {
      "id": "G1",
      "name": "a.mp3",
      "folder": false,
      "size": 99,
      "mtimeMs": 1792065600000,
      "etag": "\"{E1},2\"",
      "hashes": {
       "quickXor": "AAAAAAAAAAAAAAAAAAAAAAAAAAA="
      },
      "parentId": "PP"
     },
     {
      "id": "G2",
      "name": "sub",
      "folder": true,
      "hashes": {}
     }
    ],
    "nextCursor": "https://graph.microsoft.com/v1.0/x?$skiptoken=2",
    "incomplete": false
   }
  },
  {
   "name": "delta gone",
   "provider": "graph",
   "op": "parseList",
   "input": {
    "response": {
     "status": 410,
     "headers": {},
     "body": "{\"error\":{\"code\":\"resyncRequired\"}}"
    },
    "cursor": "x"
   },
   "expected": {
    "ok": false,
    "error": {
     "kind": "Fatal",
     "status": 410,
     "code": "ResetRequired"
    }
   }
  },
