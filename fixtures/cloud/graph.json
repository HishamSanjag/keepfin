  {
   "name": "upload empty file refused",
   "provider": "graph",
   "op": "uploadStart",
   "input": {
    "parent": {
     "path": ""
    },
    "name": "e",
    "size": 0
   },
   "expected": {
    "throws": true
   }
  },
  {
   "name": "parse upload start",
   "provider": "graph",
   "op": "parseUploadStart",
   "input": {
    "response": {
     "status": 200,
     "headers": {},
     "body": "{\"uploadUrl\":\"https://up.example/s/1\",\"expirationDateTime\":\"2026-10-16T00:00:00.000Z\",\"nextExpectedRanges\":[\"0-\"]}"
    },
    "nowMs": 1792065600000
   },
   "expected": {
    "ok": true,
    "session": {
     "kind": "graph",
     "url": "https://up.example/s/1"
    },
    "nextOffset": 0,
    "expiresAtMs": 1792108800000,
    "chunk": {
     "multiple": 327680,
     "preferred": 10485760,
     "max": 62914560
    }
   }
  },
  {
   "name": "fragment",
   "provider": "graph",
   "op": "uploadAppend",
   "input": {
    "session": {
     "url": "https://up.example/s/1"
    },
    "offset": 0,
    "length": 10485760,
    "total": 30000000
   },
   "expected": {
    "request": {
     "method": "PUT",
     "url": "https://up.example/s/1",
     "headers": {
      "Content-Length": "10485760",
      "Content-Range": "bytes 0-10485759/30000000",
      "Content-Type": "application/octet-stream"
     },
     "auth": false,
     "bodyRef": {
      "offset": 0,
      "length": 10485760
     }
    }
   }
  },
  {
   "name": "fragment last",
   "provider": "graph",
   "op": "uploadAppend",
   "input": {
    "session": {
     "url": "https://up.example/s/1"
    },
    "offset": 20971520,
    "length": 9028480,
    "total": 30000000
   },
   "expected": {
    "request": {
     "method": "PUT",
     "url": "https://up.example/s/1",
     "headers": {
      "Content-Length": "9028480",
      "Content-Range": "bytes 20971520-29999999/30000000",
      "Content-Type": "application/octet-stream"
     },
     "auth": false,
     "bodyRef": {
      "offset": 20971520,
      "length": 9028480
     }
    }
   }
  },
