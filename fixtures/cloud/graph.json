   "expected": {
    "request": {
     "method": "PUT",
     "url": "https://graph.microsoft.com/v1.0/me/drive/special/approot:/Keepfin/.keepfin/lock.json:/content?@microsoft.graph.conflictBehavior=fail",
     "headers": {
      "Content-Type": "application/octet-stream"
     },
     "auth": true,
     "body": "{}"
