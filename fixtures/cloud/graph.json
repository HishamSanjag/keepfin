     "url": "https://graph.microsoft.com/v1.0/me/drive/special/approot:/Keepfin/media/a%20b.flac:/createUploadSession",
     "headers": {
      "Content-Type": "application/json"
     },
     "auth": true,
     "body": "{\"item\":{\"@microsoft.graph.conflictBehavior\":\"fail\",\"name\":\"a b.flac\"}}"
    }
   }
  },
