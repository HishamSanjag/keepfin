    }
   }
  },
  {
   "name": "quota",
   "provider": "dropbox",
   "op": "parseQuota",
   "input": {
    "response": {
     "status": 200,
     "headers": {},
     "body": "{\"used\":100,\"allocation\":{\".tag\":\"individual\",\"allocated\":2147483648}}"
    }
   },
   "expected": {
    "ok": true,
    "usedBytes": 100,
    "totalBytes": 2147483648,
    "freeBytes": 2147483548
   }
  }
 ]
