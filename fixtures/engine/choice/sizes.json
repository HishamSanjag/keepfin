{
  "description": "The size shown before a download and expected for its job, one rule for every format and quality (issue #5). A stream kept as it is (Original; Opus from an Opus source, M4A from an AAC source, both at Best) is the size of that stream. A conversion is its bitrate times the duration: the quality asked for, else 245 kbps for MP3, 256 for M4A, 160 for Opus at Best, and 1411 for WAV. No duration: the source stream's size for a lossy format, nothing for WAV. FLAC has no estimate. A video is the size of its quality, adjusted when another audio track is picked. A figure that is not the size of one kept stream is approximate.",
  "cases": [
    {"name":"MP3 at Best is 245 kbps over the duration","input":{"op":"size","media":{"duration":200,"audio":[{"formatId":"251","codec":"opus","size":3300000,"sizeApprox":true}]},"choice":{"mode":"audio","target":"mp3","quality":"best"}},"expected":{"bytes":6125000,"approx":true}},
    {"name":"MP3 at 320","input":{"op":"size","media":{"duration":200,"audio":[{"formatId":"251","codec":"opus","size":3300000,"sizeApprox":true}]},"choice":{"mode":"audio","target":"mp3","quality":"320"}},"expected":{"bytes":8000000,"approx":true}},
    {"name":"MP3 at 128","input":{"op":"size","media":{"duration":200,"audio":[{"formatId":"251","codec":"opus","size":3300000,"sizeApprox":true}]},"choice":{"mode":"audio","target":"mp3","quality":"128"}},"expected":{"bytes":3200000,"approx":true}},
    {"name":"M4A at Best from an Opus source is converted at 256 kbps","input":{"op":"size","media":{"duration":200,"audio":[{"formatId":"251","codec":"opus","size":3300000,"sizeApprox":true}]},"choice":{"mode":"audio","target":"m4a","quality":"best"}},"expected":{"bytes":6400000,"approx":true}},
    {"name":"M4A at Best from an AAC source keeps the stream","input":{"op":"size","media":{"duration":200,"audio":[{"formatId":"140","codec":"aac","size":3400000,"sizeApprox":false}]},"choice":{"mode":"audio","target":"m4a","quality":"best"}},"expected":{"bytes":3400000,"approx":true}},
    {"name":"M4A at 128 from an AAC source is converted","input":{"op":"size","media":{"duration":200,"audio":[{"formatId":"140","codec":"aac","size":3400000,"sizeApprox":false}]},"choice":{"mode":"audio","target":"m4a","quality":"128"}},"expected":{"bytes":3200000,"approx":true}},
    {"name":"M4A at 320","input":{"op":"size","media":{"duration":200,"audio":[{"formatId":"140","codec":"aac","size":3400000}]},"choice":{"mode":"audio","target":"m4a","quality":"320"}},"expected":{"bytes":8000000,"approx":true}},
    {"name":"Opus at Best from an Opus source keeps the stream","input":{"op":"size","media":{"duration":200,"audio":[{"formatId":"251","codec":"opus","size":3300000,"sizeApprox":true}]},"choice":{"mode":"audio","target":"opus","quality":"best"}},"expected":{"bytes":3300000,"approx":true}},
    {"name":"Opus at Best from an AAC source is converted at 160 kbps","input":{"op":"size","media":{"duration":200,"audio":[{"formatId":"140","codec":"aac","size":3400000}]},"choice":{"mode":"audio","target":"opus","quality":"best"}},"expected":{"bytes":4000000,"approx":true}},
    {"name":"Opus at 128 from an Opus source is converted","input":{"op":"size","media":{"duration":200,"audio":[{"formatId":"251","codec":"opus","size":3300000,"sizeApprox":true}]},"choice":{"mode":"audio","target":"opus","quality":"128"}},"expected":{"bytes":3200000,"approx":true}},
    {"name":"Opus at 320","input":{"op":"size","media":{"duration":200,"audio":[{"formatId":"251","codec":"opus","size":3300000}]},"choice":{"mode":"audio","target":"opus","quality":"320"}},"expected":{"bytes":8000000,"approx":true}},
    {"name":"WAV is 1411 kbps over the duration","input":{"op":"size","media":{"duration":200,"audio":[{"formatId":"251","codec":"opus","size":3300000}]},"choice":{"mode":"audio","target":"wav","quality":"best"}},"expected":{"bytes":35275000,"approx":true}},
    {"name":"WAV ignores the quality","input":{"op":"size","media":{"duration":200,"audio":[{"formatId":"251","codec":"opus","size":3300000}]},"choice":{"mode":"audio","target":"wav","quality":"128"}},"expected":{"bytes":35275000,"approx":true}},
    {"name":"FLAC has no estimate","input":{"op":"size","media":{"duration":200,"audio":[{"formatId":"251","codec":"opus","size":3300000}]},"choice":{"mode":"audio","target":"flac","quality":"best"}},"expected":{"bytes":null,"approx":false}},
    {"name":"Original is the size of the source stream, as its own figure says","input":{"op":"size","media":{"duration":200,"audio":[{"formatId":"251","codec":"opus","size":3300000,"sizeApprox":true},{"formatId":"140","codec":"aac","size":3400000,"sizeApprox":false}]},"choice":{"mode":"audio","target":"original"}},"expected":{"bytes":3300000,"approx":true}},
    {"name":"Original of a picked stream","input":{"op":"size","media":{"duration":200,"audio":[{"formatId":"251","codec":"opus","size":3300000,"sizeApprox":true},{"formatId":"140","codec":"aac","size":3400000,"sizeApprox":false}]},"choice":{"mode":"audio","target":"original","audioSource":"140"}},"expected":{"bytes":3400000,"approx":false}},
    {"name":"a picked source stream sets the codec that decides Keep or convert","input":{"op":"size","media":{"duration":200,"audio":[{"formatId":"251","codec":"opus","size":3300000,"sizeApprox":true},{"formatId":"140","codec":"aac","size":3400000,"sizeApprox":false}]},"choice":{"mode":"audio","target":"m4a","quality":"best","audioSource":"140"}},"expected":{"bytes":3400000,"approx":true}},
    {"name":"MP3 at Best with no duration is the source size","input":{"op":"size","media":{"audio":[{"formatId":"251","codec":"opus","size":3300000,"sizeApprox":true}]},"choice":{"mode":"audio","target":"mp3","quality":"best"}},"expected":{"bytes":3300000,"approx":true}},
