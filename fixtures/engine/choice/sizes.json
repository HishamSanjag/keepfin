    {"name":"a video is the size of its quality, with its own flag","input":{"op":"size","media":{"video":[{"id":"1080p","size":150000000,"sizeApprox":false},{"id":"720p","size":50000000,"sizeApprox":true}]},"choice":{"mode":"video","videoId":"720p"}},"expected":{"bytes":50000000,"approx":true}},
    {"name":"a video with no quality picked is the first","input":{"op":"size","media":{"video":[{"id":"1080p","size":150000000,"sizeApprox":false}]},"choice":{"mode":"video"}},"expected":{"bytes":150000000,"approx":false}},
    {"name":"a video with no size is unknown","input":{"op":"size","media":{"video":[{"id":"360p"}]},"choice":{"mode":"video","videoId":"360p"}},"expected":{"bytes":null,"approx":false}},
    {"name":"another audio track changes the video size","input":{"op":"size","media":{"video":[{"id":"1080p","size":150000000}],"audio":[{"formatId":"251","size":3000000},{"formatId":"140-de","size":2000000}]},"choice":{"mode":"video","videoId":"1080p","audioTrack":"140-de"}},"expected":{"bytes":149000000,"approx":true}},
    {"name":"a video that already has audio ignores the track","input":{"op":"size","media":{"video":[{"id":"360p","size":22000000,"hasAudio":true}],"audio":[{"formatId":"251","size":3000000},{"formatId":"140-de","size":2000000}]},"choice":{"mode":"video","videoId":"360p","audioTrack":"140-de"}},"expected":{"bytes":22000000,"approx":false}},
