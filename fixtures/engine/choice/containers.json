{
  "description": "Which containers a video quality can be saved in (issue #3): WebM only for VP9 or AV1, MP4 and MKV for every codec. A disallowed container carries the reason the screen shows.",
  "cases": [
    {"name":"H.264 offers MP4 and MKV, not WebM","input":{"op":"offer","media":{"video":[{"id":"1080p","codec":"h264"}]},"choice":{"mode":"video","videoId":"1080p","container":"mp4"}},"expected":{"containers":[{"value":"mp4","allowed":true,"reason":null},{"value":"mkv","allowed":true,"reason":null},{"value":"webm","allowed":false,"reason":"WebM needs VP9 or AV1 video; this quality is H.264."}]}},
    {"name":"VP9 offers all three","input":{"op":"offer","media":{"video":[{"id":"1080p","codec":"vp9"}]},"choice":{"mode":"video","videoId":"1080p","container":"webm"}},"expected":{"containers":[{"value":"mp4","allowed":true,"reason":null},{"value":"mkv","allowed":true,"reason":null},{"value":"webm","allowed":true,"reason":null}]}},
    {"name":"AV1 offers WebM","input":{"op":"offer","media":{"video":[{"id":"2160p","codec":"av1"}]},"choice":{"mode":"video","videoId":"2160p","container":"mp4"}},"expected":{"containers":[{"value":"mp4","allowed":true,"reason":null},{"value":"mkv","allowed":true,"reason":null},{"value":"webm","allowed":true,"reason":null}]}},
    {"name":"HEVC is named in the reason","input":{"op":"offer","media":{"video":[{"id":"1080p","codec":"hevc"}]},"choice":{"mode":"video","videoId":"1080p"}},"expected":{"containers":[{"value":"mp4","allowed":true},{"value":"mkv","allowed":true},{"value":"webm","allowed":false,"reason":"WebM needs VP9 or AV1 video; this quality is HEVC."}]}},
    {"name":"an unknown codec has no WebM","input":{"op":"offer","media":{"video":[{"id":"best","codec":"other"}]},"choice":{"mode":"video","videoId":"best"}},"expected":{"containers":[{"value":"mp4","allowed":true},{"value":"mkv","allowed":true},{"value":"webm","allowed":false,"reason":"WebM needs VP9 or AV1 video; this quality is another codec."}]}},
    {"name":"the first quality is offered when none is picked","input":{"op":"offer","media":{"video":[{"id":"2160p","codec":"vp9"},{"id":"1080p","codec":"h264"}]},"choice":{"mode":"video"}},"expected":{"containers":[{"value":"mp4","allowed":true},{"value":"mkv","allowed":true},{"value":"webm","allowed":true,"reason":null}]}},
    {"name":"a link with no listed qualities has no WebM","input":{"op":"offer","media":{"video":[]},"choice":{"mode":"video"}},"expected":{"containers":[{"value":"mp4","allowed":true},{"value":"mkv","allowed":true},{"value":"webm","allowed":false,"reason":"WebM needs VP9 or AV1 video; this quality is another codec."}]}},
    {"name":"picking a quality that cannot be WebM returns to MP4","input":{"op":"pickVideo","media":{"video":[{"id":"2160p","codec":"vp9"},{"id":"1080p","codec":"h264"}]},"choice":{"mode":"video","videoId":"2160p","container":"webm"},"videoId":"1080p"},"expected":{"mode":"video","videoId":"1080p","container":"mp4"}},
    {"name":"picking a quality that can be WebM keeps WebM","input":{"op":"pickVideo","media":{"video":[{"id":"2160p","codec":"vp9"},{"id":"1080p","codec":"av1"}]},"choice":{"mode":"video","videoId":"2160p","container":"webm"},"videoId":"1080p"},"expected":{"videoId":"1080p","container":"webm"}},
    {"name":"picking another quality keeps MKV","input":{"op":"pickVideo","media":{"video":[{"id":"2160p","codec":"vp9"},{"id":"1080p","codec":"h264"}]},"choice":{"mode":"video","videoId":"2160p","container":"mkv"},"videoId":"1080p"},"expected":{"videoId":"1080p","container":"mkv"}},
    {"name":"picking a quality leaves the audio picks alone","input":{"op":"pickVideo","media":{"video":[{"id":"1080p","codec":"h264"}]},"choice":{"mode":"video","videoId":"1080p","container":"webm","target":"opus","quality":"128","audioTrack":"140"},"videoId":"1080p"},"expected":{"container":"mp4","target":"opus","quality":"128","audioTrack":"140"}}
  ]
}
