{
  "description": "What a choice sends to the engine (issue #7): the quality's height, exact format id and frame rate; the codec of the quality when it is H.264, HEVC, VP9 or AV1, else auto; the chosen audio language for a video that has no audio of its own; for audio the target and quality, and the source stream only for Original.",
  "cases": [
    {"name":"video: height, exact format id, frame rate, codec and container of the picked quality","input":{"op":"request","media":{"video":[{"id":"2160p","height":2160,"codec":"vp9","formatId":"313"},{"id":"1080p60","height":1080,"fps":60,"codec":"h264","formatId":"299"}]},"choice":{"mode":"video","videoId":"1080p60","container":"mkv"}},"expected":{"type":"video","maxHeight":1080,"formatId":"299","fps":60,"codec":"h264","container":"mkv","audioFormatId":null}},
    {"name":"video: no pick means the first (best) quality","input":{"op":"request","media":{"video":[{"id":"2160p","height":2160,"codec":"av1","formatId":"399"},{"id":"1080p","height":1080,"codec":"h264","formatId":"137"}]},"choice":{"mode":"video"}},"expected":{"type":"video","maxHeight":2160,"formatId":"399","codec":"av1","container":"mp4"}},
    {"name":"video: the codec is kept with an exact format id so the plan still narrows when the id has expired","input":{"op":"request","media":{"video":[{"id":"1080p","height":1080,"codec":"hevc","formatId":"hvc1"}]},"choice":{"mode":"video","videoId":"1080p","container":"mkv"}},"expected":{"type":"video","formatId":"hvc1","codec":"hevc","container":"mkv"}},
    {"name":"video: a codec the plan does not know is auto","input":{"op":"request","media":{"video":[{"id":"1080p","height":1080,"codec":"other","formatId":"22"}]},"choice":{"mode":"video","videoId":"1080p"}},"expected":{"type":"video","formatId":"22","codec":"auto"}},
    {"name":"video: a direct file has no height, so no height is asked for","input":{"op":"request","media":{"video":[{"id":"original","height":0,"codec":"other","formatId":"mp4","hasAudio":true}]},"choice":{"mode":"video","videoId":"original"}},"expected":{"type":"video","maxHeight":null,"formatId":"mp4","fps":null,"codec":"auto"}},
    {"name":"video: the chosen audio language goes with a video that has no audio of its own","input":{"op":"request","media":{"video":[{"id":"1080p","height":1080,"codec":"h264","formatId":"137"}],"audio":[{"formatId":"140-en"},{"formatId":"140-ar"}]},"choice":{"mode":"video","videoId":"1080p","audioTrack":"140-ar"}},"expected":{"type":"video","formatId":"137","audioFormatId":"140-ar"}},
    {"name":"video: no language chosen sends none","input":{"op":"request","media":{"video":[{"id":"1080p","height":1080,"codec":"h264","formatId":"137"}],"audio":[{"formatId":"140-en"},{"formatId":"140-ar"}]},"choice":{"mode":"video","videoId":"1080p"}},"expected":{"type":"video","audioFormatId":null}},
    {"name":"video: a quality that carries its own audio sends no language","input":{"op":"request","media":{"video":[{"id":"360p","height":360,"codec":"h264","formatId":"18","hasAudio":true}],"audio":[{"formatId":"140-en"},{"formatId":"140-ar"}]},"choice":{"mode":"video","videoId":"360p","audioTrack":"140-ar"}},"expected":{"type":"video","formatId":"18","audioFormatId":null}},
    {"name":"audio: MP3 at 320","input":{"op":"request","media":{"audio":[{"formatId":"140"}]},"choice":{"mode":"audio","target":"mp3","quality":"320"}},"expected":{"type":"audio","target":"mp3","quality":"320","formatId":null}},
    {"name":"audio: FLAC ignores the quality asked for","input":{"op":"request","media":{"audio":[{"formatId":"140"}]},"choice":{"mode":"audio","target":"flac","quality":"128"}},"expected":{"type":"audio","target":"flac","quality":"best","formatId":null}},
    {"name":"audio: Original ignores the quality and sends the chosen source stream","input":{"op":"request","media":{"audio":[{"formatId":"251"},{"formatId":"140"}]},"choice":{"mode":"audio","target":"original","quality":"192","audioSource":"140"}},"expected":{"type":"audio","target":"original","quality":"best","formatId":"140"}},
    {"name":"audio: Original with no stream chosen sends none (the best one)","input":{"op":"request","media":{"audio":[{"formatId":"251"},{"formatId":"140"}]},"choice":{"mode":"audio","target":"original"}},"expected":{"type":"audio","target":"original","formatId":null}},
    {"name":"audio: a converted format sends no source stream","input":{"op":"request","media":{"audio":[{"formatId":"251"},{"formatId":"140"}]},"choice":{"mode":"audio","target":"m4a","quality":"256","audioSource":"140"}},"expected":{"type":"audio","target":"m4a","quality":"256","formatId":null}}
  ]
}
