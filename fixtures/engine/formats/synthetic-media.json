    {"name":"av1 and vp9 at the same height: the codec preference decides (desktop)","platforms":["desktop"],"reason":"Desktop ranks av1 and vp9 equal and breaks the tie by bitrate.","input":{"op":"media","url":"https://www.youtube.com/watch?v=abcdefghijk","info":{"title":"T","duration":100,"formats":[{"format_id":"a1","ext":"mp4","protocol":"https","vcodec":"av01.0.08M.08","acodec":"none","width":1920,"height":1080,"fps":30,"tbr":3000},{"format_id":"v9","ext":"webm","protocol":"https","vcodec":"vp9","acodec":"none","width":1920,"height":1080,"fps":30,"tbr":2000},{"format_id":"140","ext":"m4a","protocol":"https","vcodec":"none","acodec":"mp4a.40.2","abr":128,"filesize":1600000}]}},"expected":{"provider":"YouTube","title":"T","uploader":null,"duration":100,"isLive":false,"chapters":0,"playlistUrl":null,"thumbnail":null,"music":null,"videoIds":["1080p"],"video":[{"id":"1080p","height":1080,"fps":30,"hdr":false,"codec":"av1","formatId":"a1","hasAudio":false,"size":39100000,"sizeApprox":true}],"audio":[{"formatId":"140","codec":"aac","language":null,"size":1600000,"sizeApprox":false}],"hasVideoOptions":true,"hasAudioOptions":true}},
    {"name":"av1 and vp9 at the same height: the codec preference decides (android)","platforms":["android"],"reason":"Phones decode vp9 in hardware far more often than av1, so Android ranks vp9 above av1.","input":{"op":"media","url":"https://www.youtube.com/watch?v=abcdefghijk","info":{"title":"T","duration":100,"formats":[{"format_id":"a1","ext":"mp4","protocol":"https","vcodec":"av01.0.08M.08","acodec":"none","width":1920,"height":1080,"fps":30,"tbr":3000},{"format_id":"v9","ext":"webm","protocol":"https","vcodec":"vp9","acodec":"none","width":1920,"height":1080,"fps":30,"tbr":2000},{"format_id":"140","ext":"m4a","protocol":"https","vcodec":"none","acodec":"mp4a.40.2","abr":128,"filesize":1600000}]}},"expected":{"videoIds":["1080p"],"video":[{"id":"1080p","codec":"vp9","formatId":"v9","size":26600000,"sizeApprox":true}]}},
