{
  "description": "The spaces hub: which spaces show on home (pinned ones in order, at most five; built-ins are pinned unless said otherwise; with no pins the first five), reordering, and where a download goes by default. A space is {id, pinned?, type? (folder|smart)}.",
  "cases": [
    {"name":"built-ins and explicit pins show; the rest are counted","input":{"op":"home","spaces":[{"id":"downloads"},{"id":"music"},{"id":"videos"},{"id":"kids"},{"id":"lofi","type":"smart"},{"id":"gym","pinned":true}]},"expected":{"shown":["downloads","music","videos","gym"],"more":2}},
    {"name":"with nothing pinned the first five show","input":{"op":"home","spaces":[{"id":"downloads","pinned":false},{"id":"music","pinned":false},{"id":"videos","pinned":false},{"id":"kids","pinned":false},{"id":"lofi","type":"smart","pinned":false},{"id":"gym","pinned":false}]},"expected":{"shown":["downloads","music","videos","kids","lofi"],"more":1}},
    {"name":"never more than five cards","input":{"op":"home","spaces":[{"id":"s0","pinned":true},{"id":"s1","pinned":true},{"id":"s2","pinned":true},{"id":"s3","pinned":true},{"id":"s4","pinned":true},{"id":"s5","pinned":true},{"id":"s6","pinned":true},{"id":"s7","pinned":true},{"id":"s8","pinned":true}]},"expected":{"shown":["s0","s1","s2","s3","s4"],"more":4}},
    {"name":"seven unpinned custom spaces: the first five and 2 more","input":{"op":"home","spaces":[{"id":"s1"},{"id":"s2"},{"id":"s3"},{"id":"s4"},{"id":"s5"},{"id":"s6"},{"id":"s7"}]},"expected":{"shown":["s1","s2","s3","s4","s5"],"more":2}},
    {"name":"two pinned custom spaces in hub order","input":{"op":"home","spaces":[{"id":"s1"},{"id":"s2","pinned":true},{"id":"s3"},{"id":"s4"},{"id":"s5"},{"id":"s6","pinned":true},{"id":"s7"}]},"expected":{"shown":["s2","s6"],"more":5}},
    {"name":"only the built-in spaces","input":{"op":"home","spaces":[{"id":"downloads"},{"id":"music"},{"id":"videos"}]},"expected":{"shown":["downloads","music","videos"],"more":0}},
    {"name":"reorder covers built-ins too","input":{"op":"reorder","spaces":[{"id":"downloads"},{"id":"music"},{"id":"videos"},{"id":"kids"},{"id":"lofi","type":"smart"},{"id":"gym"}],"ids":["gym","videos","music","downloads","kids","lofi"]},"expected":{"order":["gym","videos","music","downloads","kids","lofi"]}},
    {"name":"spaces left out keep their order at the end","input":{"op":"reorder","spaces":[{"id":"downloads"},{"id":"music"},{"id":"videos"},{"id":"kids"},{"id":"lofi","type":"smart"},{"id":"gym"}],"ids":["kids"]},"expected":{"order":["kids","downloads","music","videos","lofi","gym"]}},
    {"name":"an unknown id is rejected as out of date","input":{"op":"reorder","spaces":[{"id":"downloads"},{"id":"music"},{"id":"gym"}],"ids":["nope"]},"expected":{"error":true}},
    {"name":"a repeated id is rejected as out of date","input":{"op":"reorder","spaces":[{"id":"downloads"},{"id":"music"},{"id":"kids"}],"ids":["kids","kids"]},"expected":{"error":true}},
    {"name":"move: one place later","input":{"op":"move","ids":["a","b","c","d"],"id":"b","forward":true},"expected":{"order":["a","c","b","d"]}},
    {"name":"move: one place earlier","input":{"op":"move","ids":["a","b","c","d"],"id":"b","forward":false},"expected":{"order":["b","a","c","d"]}},
    {"name":"move: the first stays first","input":{"op":"move","ids":["a","b"],"id":"a","forward":false},"expected":{"order":["a","b"]}},
    {"name":"move: the last stays last","input":{"op":"move","ids":["a","b"],"id":"b","forward":true},"expected":{"order":["a","b"]}},
    {"name":"move: an unknown id changes nothing","input":{"op":"move","ids":["a","b"],"id":"zzz","forward":true},"expected":{"order":["a","b"]}},
    {"name":"route: a music link goes to the music route","input":{"op":"route","url":"https://open.spotify.com/track/abcdefghij","routes":{"music":"music","other":"videos"},"spaces":[{"id":"downloads"},{"id":"music"},{"id":"videos"}]},"expected":"music"},
    {"name":"route: a youtube music link is music","input":{"op":"route","url":"https://music.youtube.com/watch?v=abcdefghijk","routes":{"music":"music","other":"videos"},"spaces":[{"id":"downloads"},{"id":"music"},{"id":"videos"}]},"expected":"music"},
    {"name":"route: any other link goes to the other route","input":{"op":"route","url":"https://www.youtube.com/watch?v=abcdefghijk","routes":{"music":"music","other":"videos"},"spaces":[{"id":"downloads"},{"id":"music"},{"id":"videos"}]},"expected":"videos"},
    {"name":"route: a smart space is never a target","input":{"op":"route","url":"https://open.spotify.com/track/abcdefghij","routes":{"music":"lofi","other":"downloads"},"spaces":[{"id":"downloads"},{"id":"music"},{"id":"videos"},{"id":"lofi","type":"smart"}]},"expected":"downloads"},
    {"name":"route: a stale route falls back to a folder space","input":{"op":"route","url":"https://www.youtube.com/watch?v=abcdefghijk","routes":{"music":"music","other":"gone"},"spaces":[{"id":"downloads"},{"id":"music"},{"id":"videos"}]},"expected":"downloads"},
    {"name":"route: a stale route falls back to the first folder space in hub order","input":{"op":"route","url":"https://www.youtube.com/watch?v=abcdefghijk","routes":{"music":"music","other":"gone"},"spaces":[{"id":"lofi","type":"smart"},{"id":"music"},{"id":"downloads"}]},"expected":"music"},
    {"name":"route: with no folder space the answer is downloads","input":{"op":"route","url":"https://www.youtube.com/watch?v=abcdefghijk","routes":{"music":"music","other":"gone"},"spaces":[{"id":"lofi","type":"smart"}]},"expected":"downloads"},
    {"name":"route: a short spotify link goes to the music route","input":{"op":"route","url":"https://spotify.link/abc123","routes":{"music":"music","other":"videos"},"spaces":[{"id":"downloads"},{"id":"music"},{"id":"videos"}]},"expected":"music"},
    {"name":"route: a podcast page of a music service is not music","input":{"op":"route","url":"https://open.spotify.com/show/abcdefghij","routes":{"music":"music","other":"videos"},"spaces":[{"id":"downloads"},{"id":"music"},{"id":"videos"}]},"expected":"videos"},
    {"name":"home: exactly five pinned spaces leave nothing more","input":{"op":"home","spaces":[{"id":"s0","pinned":true},{"id":"s1","pinned":true},{"id":"s2","pinned":true},{"id":"s3","pinned":true},{"id":"s4","pinned":true}]},"expected":{"shown":["s0","s1","s2","s3","s4"],"more":0}},
    {"name":"home: a built-in can be unpinned","input":{"op":"home","spaces":[{"id":"downloads","pinned":false},{"id":"music"},{"id":"videos"}]},"expected":{"shown":["music","videos"],"more":1}},
    {"name":"reorder: an empty list changes nothing","input":{"op":"reorder","spaces":[{"id":"downloads"},{"id":"music"}],"ids":[]},"expected":{"order":["downloads","music"]}}
  ]
}
