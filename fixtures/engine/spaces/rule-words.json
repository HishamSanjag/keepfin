{
  "description": "The words of smart rules and the tag filter's smart space, written once in the core (RuleWords) and shown by both apps in the phone's wording: 'Tag is lofi or chill', 'Not played yet', 'Arabic + Chill'. Collection and space ids become names through the names the screen looks up; kinds read Songs, Videos, Photos, Other files.",
  "cases": [
    {"name":"one tag","input":{"op":"ruleWords","rules":{"match":"any","rules":[{"field":"tag","values":["lofi"]}]}},"expected":"Tag is lofi"},
    {"name":"two values are joined with or","input":{"op":"ruleWords","rules":{"match":"any","rules":[{"field":"tag","values":["lofi","chill"]}]}},"expected":"Tag is lofi or chill"},
    {"name":"three values: commas, then or","input":{"op":"ruleWords","rules":{"match":"any","rules":[{"field":"tag","values":["a","b","c"]}]}},"expected":"Tag is a, b or c"},
    {"name":"collection: the name, and the id when the name is not known","input":{"op":"ruleWords","names":{"collection":{"c1":"Gym"}},"rules":{"match":"any","rules":[{"field":"collection","values":["c1","c2"]}]}},"expected":"Collection is Gym or c2"},
    {"name":"space: the name","input":{"op":"ruleWords","names":{"space":{"w":"Workout"}},"rules":{"match":"any","rules":[{"field":"space","values":["w"]}]}},"expected":"Space is Workout"},
    {"name":"source site","input":{"op":"ruleWords","rules":{"match":"any","rules":[{"field":"source","values":["youtube"]}]}},"expected":"Source site is youtube"},
    {"name":"artist and channel","input":{"op":"ruleWords","rules":{"match":"any","rules":[{"field":"artist","values":["Fairuz"]}]}},"expected":"Artist / channel is Fairuz"},
    {"name":"album","input":{"op":"ruleWords","rules":{"match":"any","rules":[{"field":"album","values":["Hajar"]}]}},"expected":"Album is Hajar"},
    {"name":"kind: songs","input":{"op":"ruleWords","rules":{"match":"any","rules":[{"field":"kind","values":["audio"]}]}},"expected":"Kind is Songs"},
    {"name":"kind: every kind","input":{"op":"ruleWords","rules":{"match":"any","rules":[{"field":"kind","values":["audio","video","image","other"]}]}},"expected":"Kind is Songs, Videos, Photos or Other files"},
    {"name":"added within one day","input":{"op":"ruleWords","rules":{"match":"any","rules":[{"field":"addedWithin","days":1}]}},"expected":"Added in the last day"},
    {"name":"added within 30 days stays in days","input":{"op":"ruleWords","rules":{"match":"any","rules":[{"field":"addedWithin","days":30}]}},"expected":"Added in the last 30 days"},
    {"name":"added within 7 days","input":{"op":"ruleWords","rules":{"match":"any","rules":[{"field":"addedWithin","days":7}]}},"expected":"Added in the last 7 days"},
    {"name":"added within 60 days reads as months","input":{"op":"ruleWords","rules":{"match":"any","rules":[{"field":"addedWithin","days":60}]}},"expected":"Added in the last 2 months"},
    {"name":"added within 90 days reads as months","input":{"op":"ruleWords","rules":{"match":"any","rules":[{"field":"addedWithin","days":90}]}},"expected":"Added in the last 3 months"},
    {"name":"added within 45 days (not a whole number of months) stays in days","input":{"op":"ruleWords","rules":{"match":"any","rules":[{"field":"addedWithin","days":45}]}},"expected":"Added in the last 45 days"},
    {"name":"favorite","input":{"op":"ruleWords","rules":{"match":"any","rules":[{"field":"favorite"}]}},"expected":"Favorite"},
    {"name":"not played yet","input":{"op":"ruleWords","rules":{"match":"any","rules":[{"field":"unplayed"}]}},"expected":"Not played yet"},
    {"name":"match all joins the rules with and, and only one kind is added","input":{"op":"ruleWords","rules":{"match":"all","onlyKind":"audio","rules":[{"field":"tag","values":["pop"]},{"field":"favorite"}]}},"expected":"Tag is pop and Favorite · only songs"},
    {"name":"match any joins the rules with or","input":{"op":"ruleWords","rules":{"match":"any","rules":[{"field":"tag","values":["pop"]},{"field":"favorite"}]}},"expected":"Tag is pop or Favorite"},
    {"name":"onlyKind: other files","input":{"op":"ruleWords","rules":{"match":"any","onlyKind":"other","rules":[{"field":"unplayed"}]}},"expected":"Not played yet · only other files"},
    {"name":"onlyKind: videos","input":{"op":"ruleWords","rules":{"match":"any","onlyKind":"video","rules":[{"field":"unplayed"}]}},"expected":"Not played yet · only videos"},
    {"name":"onlyKind: photos","input":{"op":"ruleWords","rules":{"match":"any","onlyKind":"image","rules":[{"field":"unplayed"}]}},"expected":"Not played yet · only photos"},
    {"name":"three rules with a space rule","input":{"op":"ruleWords","names":{"space":{"music":"Music"}},"rules":{"match":"all","rules":[{"field":"tag","values":["lofi","chill"]},{"field":"space","values":["music"]},{"field":"addedWithin","days":30}]}},"expected":"Tag is lofi or chill and Space is Music and Added in the last 30 days"},
    {"name":"no rules","input":{"op":"ruleWords","rules":{"match":"all","rules":[]}},"expected":"No rules yet"},
    {"name":"no rules, even with a kind","input":{"op":"ruleWords","rules":{"match":"any","onlyKind":"audio","rules":[]}},"expected":"No rules yet"},

    {"name":"tag filter, any: one tag rule, tags in A to Z order, match any","input":{"op":"tagRules","tags":["pop","arabic"],"match":"any"},"expected":{"match":"any","rules":[{"field":"tag","values":["arabic","pop"]}]}},
    {"name":"tag filter, all: a rule per tag","input":{"op":"tagRules","tags":["pop","arabic"],"match":"all"},"expected":{"match":"all","rules":[{"field":"tag","values":["arabic"]},{"field":"tag","values":["pop"]}]}},
    {"name":"tag filter in a space: any keeps to the space and every rule must match","input":{"op":"tagRules","tags":["pop","arabic"],"match":"any","space":"music"},"expected":{"match":"all","rules":[{"field":"tag","values":["arabic","pop"]},{"field":"space","values":["music"]}]}},
    {"name":"tag filter in a space: all","input":{"op":"tagRules","tags":["pop","arabic"],"match":"all","space":"music"},"expected":{"match":"all","rules":[{"field":"tag","values":["arabic"]},{"field":"tag","values":["pop"]},{"field":"space","values":["music"]}]}},
    {"name":"tag filter: a tag chosen twice counts once","input":{"op":"tagRules","tags":["pop","pop"],"match":"all"},"expected":{"match":"all","rules":[{"field":"tag","values":["pop"]}]}},
    {"name":"tag filter: only one kind","platforms":["android"],"input":{"op":"tagRules","tags":["pop"],"match":"any","onlyKind":"audio"},"expected":{"match":"any","rules":[{"field":"tag","values":["pop"]}],"onlyKind":"audio"}},
    {"name":"tag filter name: capitals, A to Z, joined with plus","input":{"op":"tagName","tags":["pop","arabic"]},"expected":"Arabic + Pop"},
    {"name":"tag filter name: one tag","input":{"op":"tagName","tags":["lofi"]},"expected":"Lofi"},
    {"name":"tag filter name: at most three tags","input":{"op":"tagName","tags":["d","c","b","a"]},"expected":"A + B + C"},
    {"name":"tag filter name: at most 40 characters","input":{"op":"tagName","tags":["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"]},"expected":"Aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa + Bbbbbbb"},
    {"name":"tag filter name: a tag chosen twice counts once","input":{"op":"tagName","tags":["pop","pop","rock"]},"expected":"Pop + Rock"},
    {"name":"tag filter name: no tags","input":{"op":"tagName","tags":[]},"expected":""},

    {"name":"count: one song","platforms":["android"],"input":{"op":"countLabel","total":1,"audio":1},"expected":"1 song"},
    {"name":"count: songs","platforms":["android"],"input":{"op":"countLabel","total":58,"audio":58},"expected":"58 songs"},
    {"name":"count: one video","platforms":["android"],"input":{"op":"countLabel","total":1,"video":1},"expected":"1 video"},
    {"name":"count: videos","platforms":["android"],"input":{"op":"countLabel","total":2,"video":2},"expected":"2 videos"},
    {"name":"count: one photo","platforms":["android"],"input":{"op":"countLabel","total":1,"image":1},"expected":"1 photo"},
    {"name":"count: photos","platforms":["android"],"input":{"op":"countLabel","total":3,"image":3},"expected":"3 photos"},
    {"name":"count: other files are items","platforms":["android"],"input":{"op":"countLabel","total":4,"other":4},"expected":"4 items"},
    {"name":"count: several kinds are items","platforms":["android"],"input":{"op":"countLabel","total":2,"audio":1,"video":1},"expected":"2 items"},
    {"name":"count: one item of another kind","platforms":["android"],"input":{"op":"countLabel","total":1,"other":1},"expected":"1 item"},
    {"name":"count: none","platforms":["android"],"input":{"op":"countLabel","total":0},"expected":"0 items"},

    {"name":"origin: biggest first, with names","platforms":["android"],"input":{"op":"origin","names":{"music":"Music","downloads":"Downloads"},"bySpace":{"downloads":7,"music":51}},"expected":"From Music (51) and Downloads (7)"},
    {"name":"origin: an unknown id stands for itself, empty spaces are left out","platforms":["android"],"input":{"op":"origin","names":{},"bySpace":{"a":3,"b":0,"c":1}},"expected":"From a (3) and c (1)"},
    {"name":"origin: five spaces, at most four are named","platforms":["android"],"input":{"op":"origin","names":{},"bySpace":{"a":5,"b":4,"c":3,"d":2,"e":1}},"expected":"From a (5), b (4), c (3) and d (2)"},
    {"name":"origin: one space","platforms":["android"],"input":{"op":"origin","names":{"m":"Music"},"bySpace":{"m":2}},"expected":"From Music (2)"},
    {"name":"origin: nothing","platforms":["android"],"input":{"op":"origin","names":{},"bySpace":{}},"expected":""}
  ]
}
