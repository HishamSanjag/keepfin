{
  "description": "The words around a downloaded collection, written once in the core (CollectionWords) and shown by both apps in the phone wording: 'Playlist · 31 songs · following, checked 12 min ago', 'Following · every 6 hours', 'Checked 12 min ago · 3 new songs added'. Times are parameters: ageMs is how long before now (1800000000000 ms) the time was; the date written for something a week old or older is 'date <ms>' here, each screen writes it in its own locale.",
  "cases": [
    {"name":"kind: playlist","input":{"op":"collectionWord","kind":"playlist"},"expected":"Playlist"},
    {"name":"kind: album","input":{"op":"collectionWord","kind":"album"},"expected":"Album"},
    {"name":"kind: channel","input":{"op":"collectionWord","kind":"channel"},"expected":"Channel"},
    {"name":"kind: own","input":{"op":"collectionWord","kind":"own"},"expected":"Yours"},

    {"name":"every: one hour","input":{"op":"everyWords","hours":1},"expected":"every hour"},
    {"name":"every: several hours","input":{"op":"everyWords","hours":6},"expected":"every 6 hours"},
    {"name":"every: a day","input":{"op":"everyWords","hours":24},"expected":"every day"},
    {"name":"every: a week","input":{"op":"everyWords","hours":168},"expected":"every week"},
    {"name":"every: another number of hours","input":{"op":"everyWords","hours":48},"expected":"every 48 hours"},
    {"name":"interval: one hour","input":{"op":"intervalLabel","hours":1},"expected":"1 hour"},
    {"name":"interval: several hours","input":{"op":"intervalLabel","hours":12},"expected":"12 hours"},
    {"name":"interval: a day","input":{"op":"intervalLabel","hours":24},"expected":"24 hours"},
    {"name":"interval: a week","input":{"op":"intervalLabel","hours":168},"expected":"7 days"},

    {"name":"follow line: automatic","input":{"op":"followLine","kind":"playlist","sourceUrl":"https://www.youtube.com/playlist?list=PL1","mode":"auto","intervalHours":6},"expected":"Following · every 6 hours"},
    {"name":"follow line: automatic, every day","input":{"op":"followLine","kind":"channel","sourceUrl":"https://www.youtube.com/@x","mode":"auto","intervalHours":24},"expected":"Following · every day"},
    {"name":"follow line: manual, on the phone","input":{"op":"followLine","kind":"playlist","sourceUrl":"https://www.youtube.com/playlist?list=PL1","mode":"manual","intervalHours":6},"expected":"Checks when you tap Check now"},
    {"name":"follow line: manual, with a mouse","input":{"op":"followLine","kind":"playlist","sourceUrl":"https://www.youtube.com/playlist?list=PL1","mode":"manual","intervalHours":6,"press":"click"},"expected":"Checks when you click Check now"},
    {"name":"follow line: off","input":{"op":"followLine","kind":"playlist","sourceUrl":"https://www.youtube.com/playlist?list=PL1","mode":"off","intervalHours":6},"expected":"Not following"},
    {"name":"follow line: no settings","input":{"op":"followLine","kind":"playlist","sourceUrl":"https://www.youtube.com/playlist?list=PL1"},"expected":"Not following"},
    {"name":"follow line: your own playlist cannot be followed","input":{"op":"followLine","kind":"own","mode":"auto","intervalHours":6},"expected":null},
    {"name":"follow line: a collection with no source cannot be followed","input":{"op":"followLine","kind":"playlist","mode":"auto","intervalHours":6},"expected":null},
    {"name":"follow line: a radio mix never ends, so it cannot be followed","input":{"op":"followLine","kind":"playlist","sourceUrl":"https://www.youtube.com/watch?v=x&list=RDabc","mode":"auto","intervalHours":6},"expected":null},

    {"name":"ago: nothing yet","input":{"op":"ago","ageMs":0},"expected":"just now"},
    {"name":"ago: 59.999 seconds is still just now","input":{"op":"ago","ageMs":59999},"expected":"just now"},
    {"name":"ago: a time ahead of now is just now","input":{"op":"ago","ageMs":-5000},"expected":"just now"},
    {"name":"ago: one minute","input":{"op":"ago","ageMs":60000},"expected":"1 min ago"},
    {"name":"ago: 12 minutes","input":{"op":"ago","ageMs":720000},"expected":"12 min ago"},
    {"name":"ago: 59 minutes","input":{"op":"ago","ageMs":3599999},"expected":"59 min ago"},
    {"name":"ago: one hour","input":{"op":"ago","ageMs":3600000},"expected":"1 h ago"},
    {"name":"ago: 3 hours","input":{"op":"ago","ageMs":10800000},"expected":"3 h ago"},
    {"name":"ago: 23 hours","input":{"op":"ago","ageMs":86399999},"expected":"23 h ago"},
    {"name":"ago: 24 hours is yesterday","input":{"op":"ago","ageMs":86400000},"expected":"yesterday"},
    {"name":"ago: 47 hours is still yesterday","input":{"op":"ago","ageMs":172799999},"expected":"yesterday"},
    {"name":"ago: 48 hours","input":{"op":"ago","ageMs":172800000},"expected":"2 days ago"},
    {"name":"ago: 4 days","input":{"op":"ago","ageMs":345600000},"expected":"4 days ago"},
    {"name":"ago: 6 days","input":{"op":"ago","ageMs":604799999},"expected":"6 days ago"},
    {"name":"ago: a week is written as a date","input":{"op":"ago","ageMs":604800000},"expected":"date 1799395200000"},
    {"name":"ago: months are a date too","input":{"op":"ago","ageMs":7776000000},"expected":"date 1792224000000"},

    {"platforms":["android"],"name":"checked: never","input":{"op":"checkedLine"},"expected":"Not checked yet"},
    {"platforms":["android"],"name":"checked: the last error wins","input":{"op":"checkedLine","ageMs":720000,"lastError":"Offline","newCount":3},"expected":"Offline"},
