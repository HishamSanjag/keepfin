    {"platforms":["android"],"name":"checked: one new song","input":{"op":"checkedLine","ageMs":720000,"newCount":1,"noun":"song"},"expected":"Checked 12 min ago · 1 new song added"},
    {"platforms":["android"],"name":"checked: three new songs","input":{"op":"checkedLine","ageMs":720000,"newCount":3,"noun":"song"},"expected":"Checked 12 min ago · 3 new songs added"},
    {"platforms":["android"],"name":"checked: new items","input":{"op":"checkedLine","ageMs":10800000,"newCount":2,"noun":"item"},"expected":"Checked 3 h ago · 2 new items added"},
    {"platforms":["android"],"name":"checked: a week ago is a date","input":{"op":"checkedLine","ageMs":604800000},"expected":"Checked date 1799395200000"},

    {"name":"row: following, checked","input":{"op":"rowSubtitle","kind":"playlist","sourceUrl":"https://www.youtube.com/playlist?list=PL1","noun":"song","present":1,"mode":"auto","ageMs":720000},"expected":"Playlist · 1 song · following, checked 12 min ago"},
    {"name":"row: following, never checked","input":{"op":"rowSubtitle","kind":"channel","sourceUrl":"https://www.youtube.com/@x","noun":"song","present":31,"mode":"auto"},"expected":"Channel · 31 songs · following"},
    {"name":"row: manual","input":{"op":"rowSubtitle","kind":"playlist","sourceUrl":"https://www.youtube.com/playlist?list=PL1","noun":"item","present":2,"mode":"manual"},"expected":"Playlist · 2 items · manual"},
    {"name":"row: not following","input":{"op":"rowSubtitle","kind":"playlist","sourceUrl":"https://www.youtube.com/playlist?list=PL1","noun":"song","present":4,"mode":"off"},"expected":"Playlist · 4 songs · not following"},
    {"name":"row: an album that is not followed says nothing","input":{"op":"rowSubtitle","kind":"album","sourceUrl":"https://www.youtube.com/playlist?list=OLAK5uy_x","noun":"song","present":11,"mode":"off"},"expected":"Album · 11 songs"},
    {"name":"row: no settings","input":{"op":"rowSubtitle","kind":"playlist","sourceUrl":"https://www.youtube.com/playlist?list=PL1","noun":"song","present":3},"expected":"Playlist · 3 songs"},
    {"name":"row: your own playlist","input":{"op":"rowSubtitle","kind":"own","noun":"song","present":2,"mode":"auto"},"expected":"Yours · 2 songs"},
    {"name":"row: a week since the last check is a date","input":{"op":"rowSubtitle","kind":"playlist","sourceUrl":"https://www.youtube.com/playlist?list=PL1","noun":"song","present":5,"mode":"auto","ageMs":604800000},"expected":"Playlist · 5 songs · following, checked date 1799395200000"},
    {"name":"row: a big collection groups its digits","input":{"op":"rowSubtitle","kind":"playlist","sourceUrl":"https://www.youtube.com/playlist?list=PL1","noun":"song","present":1234,"mode":"off"},"expected":"Playlist · 1,234 songs · not following"},
    {"name":"row: extras the screen adds come last","input":{"op":"rowSubtitle","kind":"playlist","sourceUrl":"https://www.youtube.com/playlist?list=PL1","noun":"song","present":5,"mode":"auto","ageMs":60000,"extras":["Offline","2 new"]},"expected":"Playlist · 5 songs · following, checked 1 min ago · Offline · 2 new"}
  ]
}
