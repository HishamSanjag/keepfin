{
  "description": "Collections: source order, playlist migration, source identity and kind, follow defaults and the schedule. now = 1800000000000 and 1 hour = 3600000 ms.",
  "cases": [
    {"name":"items sort by their place in the source; items without one follow in their own order","input":{"op":"order","ids":["c","x","a","y","b"],"index":{"c":2,"a":0,"b":1}},"expected":{"ids":["a","b","c","x","y"]}},
    {"name":"an empty collection stays empty","input":{"op":"order","ids":[],"index":{}},"expected":{"ids":[]}},
    {"name":"a playlist becomes a collection of kind own, keeping name, order and times","input":{"op":"migratePlaylist","space":"music","playlist":{"id":"pl-1","name":"Gym","itemIds":["b","a"],"createdAt":5,"updatedAt":9}},"expected":{"id":"pl-1","name":"Gym","kind":"own","space":"music","itemIds":["b","a"],"seen":[],"createdAt":5,"updatedAt":9}},
    {"name":"a playlist with ids that no longer exist keeps them","input":{"op":"migratePlaylist","space":"music","playlist":{"id":"pl-2","name":"Focus","itemIds":["i1","gone"],"createdAt":5,"updatedAt":9}},"expected":{"itemIds":["i1","gone"],"kind":"own"}},
    {"name":"same source: a music.youtube.com and a youtube.com playlist link","input":{"op":"sameSource","a":"https://music.youtube.com/playlist?list=PLabc123&si=zzz","b":"https://www.youtube.com/playlist?list=PLabc123"},"expected":{"same":true}},
    {"name":"same source: a watch link inside the playlist","input":{"op":"sameSource","a":"https://www.youtube.com/watch?v=aaaaaaaaaaa&list=PLabc123&index=4","b":"https://www.youtube.com/playlist?list=PLabc123"},"expected":{"same":true}},
    {"name":"same source: a spotify playlist with an intl prefix and a share id","input":{"op":"sameSource","a":"https://open.spotify.com/intl-de/playlist/37i9dQZF1DX4sWSpwq3LiO?si=1","b":"https://open.spotify.com/playlist/37i9dQZF1DX4sWSpwq3LiO"},"expected":{"same":true}},
    {"name":"same source: a soundcloud set with tracking","input":{"op":"sameSource","a":"https://soundcloud.com/a/sets/b/?utm_campaign=1#x","b":"https://soundcloud.com/a/sets/b"},"expected":{"same":true}},
    {"name":"same source: a channel and its videos tab","input":{"op":"sameSource","a":"https://youtube.com/@Some_Channel/videos?utm_source=x","b":"https://www.youtube.com/@Some_Channel"},"expected":{"same":true}},
    {"name":"different playlists are different sources","input":{"op":"sameSource","a":"https://www.youtube.com/playlist?list=PLaaa","b":"https://www.youtube.com/playlist?list=PLbbb"},"expected":{"same":false}},
    {"name":"canonical link and id of a youtube music playlist","input":{"op":"canonical","url":"https://music.youtube.com/playlist?list=PLabc123&si=zzz"},"expected":{"url":"https://www.youtube.com/playlist?list=PLabc123","id":"PLabc123"}},
    {"name":"canonical link and id of a watch link inside a playlist","input":{"op":"canonical","url":"https://www.youtube.com/watch?v=aaaaaaaaaaa&list=PLabc123&index=4"},"expected":{"url":"https://www.youtube.com/playlist?list=PLabc123","id":"PLabc123"}},
    {"name":"canonical link of a channel tab","input":{"op":"canonical","url":"https://youtube.com/@Some_Channel/videos?utm_source=x"},"expected":{"url":"https://www.youtube.com/@Some_Channel","id":"@Some_Channel"}},
    {"name":"canonical link of a spotify playlist","input":{"op":"canonical","url":"https://open.spotify.com/intl-de/playlist/37i9dQZF1DX4sWSpwq3LiO?si=1"},"expected":{"url":"https://open.spotify.com/playlist/37i9dQZF1DX4sWSpwq3LiO","id":"37i9dQZF1DX4sWSpwq3LiO"}},
    {"name":"kind: playlist","input":{"op":"collectionKind","url":"https://www.youtube.com/playlist?list=PLabc123"},"expected":{"kind":"playlist","infinite":false}},
    {"name":"kind: youtube music album page","input":{"op":"collectionKind","url":"https://music.youtube.com/browse/MPREb_abc"},"expected":{"kind":"album","infinite":false}},
    {"name":"kind: youtube music album playlist (OLAK)","input":{"op":"collectionKind","url":"https://music.youtube.com/playlist?list=OLAK5uy_abc"},"expected":{"kind":"album","infinite":false}},
    {"name":"kind: spotify album","input":{"op":"collectionKind","url":"https://open.spotify.com/album/1A2B3C4D5E6F"},"expected":{"kind":"album","infinite":false}},
    {"name":"kind: channel handle","input":{"op":"collectionKind","url":"https://www.youtube.com/@Some_Channel"},"expected":{"kind":"channel","infinite":false}},
    {"name":"kind: channel id","input":{"op":"collectionKind","url":"https://www.youtube.com/channel/UCabc"},"expected":{"kind":"channel","infinite":false}},
    {"name":"a radio mix never ends","input":{"op":"collectionKind","url":"https://www.youtube.com/watch?v=aaaaaaaaaaa&list=RDaaaaaaaaaaa"},"expected":{"kind":"playlist","infinite":true}},
    {"name":"a curated mix playlist is finite","input":{"op":"collectionKind","url":"https://music.youtube.com/playlist?list=RDCLAK5uy_abc"},"expected":{"kind":"playlist","infinite":false}},
    {"name":"a watch link inside a curated mix is finite","input":{"op":"collectionKind","url":"https://music.youtube.com/watch?v=aaaaaaaaaaa&list=RDCLAK5uy_abc"},"expected":{"kind":"playlist","infinite":false}},
    {"name":"default follow: playlists are not followed unless the user turns on Keep in sync","input":{"op":"defaultFollow","kind":"playlist","url":"https://www.youtube.com/playlist?list=PLabc123"},"expected":{"mode":"off","intervalHours":6,"wifiOnly":true,"notify":true,"confirmAbove":20}},
    {"name":"default follow: channels are not followed by default","input":{"op":"defaultFollow","kind":"channel","url":"https://www.youtube.com/@Some_Channel"},"expected":{"mode":"off"}},
    {"name":"default follow: Keep in sync on a playlist checks automatically at the chosen interval","input":{"op":"defaultFollow","kind":"playlist","url":"https://www.youtube.com/playlist?list=PLabc123","keepInSyncHours":12},"expected":{"mode":"auto","intervalHours":12,"wifiOnly":true,"notify":true,"confirmAbove":20}},
    {"name":"default follow: Keep in sync on a channel","input":{"op":"defaultFollow","kind":"channel","url":"https://www.youtube.com/@Some_Channel","keepInSyncHours":168},"expected":{"mode":"auto","intervalHours":168}},
    {"name":"default follow: an interval that is not offered is ignored","input":{"op":"defaultFollow","kind":"playlist","url":"https://www.youtube.com/playlist?list=PLabc123","keepInSyncHours":5},"expected":{"mode":"off","intervalHours":6}},
    {"name":"default follow: albums are not followed","input":{"op":"defaultFollow","kind":"album","url":"https://open.spotify.com/album/1A2B3C4D5E6F"},"expected":{"mode":"off"}},
    {"name":"default follow: albums stay off even with Keep in sync","input":{"op":"defaultFollow","kind":"album","url":"https://open.spotify.com/album/1A2B3C4D5E6F","keepInSyncHours":6},"expected":{"mode":"off"}},
    {"name":"default follow: radio mixes are never followed","input":{"op":"defaultFollow","kind":"playlist","url":"https://www.youtube.com/watch?v=aaaaaaaaaaa&list=RDaaaaaaaaaaa"},"expected":{"mode":"off"}},
    {"name":"default follow: radio mixes stay off even with Keep in sync","input":{"op":"defaultFollow","kind":"playlist","url":"https://www.youtube.com/watch?v=aaaaaaaaaaa&list=RDaaaaaaaaaaa","keepInSyncHours":6},"expected":{"mode":"off"}},
    {"name":"default follow: the user's own lists are not followed","input":{"op":"defaultFollow","kind":"own"},"expected":{"mode":"off"}},
    {"name":"due: automatic collections whose interval has passed","input":{"op":"due","now":1800000000000,"collections":[{"id":"never","sourceUrl":"https://www.youtube.com/playlist?list=PL1","follow":{"mode":"auto"}},{"id":"recent","sourceUrl":"https://www.youtube.com/playlist?list=PL2","follow":{"mode":"auto","lastCheckedAt":1799992800000}},{"id":"old","sourceUrl":"https://www.youtube.com/playlist?list=PL3","follow":{"mode":"auto","lastCheckedAt":1799974800000}},{"id":"manual","sourceUrl":"https://www.youtube.com/playlist?list=PL4","follow":{"mode":"manual"}},{"id":"off","sourceUrl":"https://www.youtube.com/playlist?list=PL5","follow":{"mode":"off"}},{"id":"held","sourceUrl":"https://www.youtube.com/playlist?list=PL6","follow":{"mode":"auto","pending":{"count":30,"at":1799996400000}}},{"id":"daily","sourceUrl":"https://www.youtube.com/playlist?list=PL7","follow":{"mode":"auto","intervalHours":24,"lastCheckedAt":1799974800000}},{"id":"mix","sourceUrl":"https://www.youtube.com/watch?v=aaaaaaaaaaa&list=RDaaaaaaaaaaa","follow":{"mode":"auto"}},{"id":"own","kind":"own","follow":{"mode":"auto"}},{"id":"nosource","follow":{"mode":"auto"}}]},"expected":{"ids":["never","old"]}},
    {"name":"due: a metered network skips wifi-only collections","platforms":["android"],"input":{"op":"due","now":1800000000000,"metered":true,"collections":[{"id":"wifi","sourceUrl":"https://www.youtube.com/playlist?list=PL1","follow":{"mode":"auto"}},{"id":"cellular","sourceUrl":"https://www.youtube.com/playlist?list=PL2","follow":{"mode":"auto","wifiOnly":false}}]},"expected":{"ids":["cellular"]}},
    {"name":"canonical link of an unknown site: tracking removed, host lower-cased, www and fragment dropped","input":{"op":"canonical","url":"https://www.Example.com/post/1?utm_source=x&id=2&si=3#frag"},"expected":{"url":"https://example.com/post/1?id=2","id":"1"}},
    {"name":"canonical link keeps other parameters written the way a browser writes them","input":{"op":"canonical","url":"https://example.com/a?q=a%20b&utm_medium=x"},"expected":{"url":"https://example.com/a?q=a+b","id":"a"}},
    {"name":"canonical link with only tracking parameters has no query and no trailing slash","input":{"op":"canonical","url":"https://example.com/sets/mine/?utm_campaign=1"},"expected":{"url":"https://example.com/sets/mine","id":"mine"}},
    {"name":"canonical link of text that is not a link is returned as it is","input":{"op":"canonical","url":"not a link"},"expected":{"url":"not a link","id":null}},
    {"name":"canonical link of a youtube channel by id on the mobile site","input":{"op":"canonical","url":"https://m.youtube.com/channel/UCabc/videos"},"expected":{"url":"https://www.youtube.com/channel/UCabc","id":"UCabc"}},
    {"name":"canonical link of an apple music album","input":{"op":"canonical","url":"https://music.apple.com/us/album/some-album/1234567890"},"expected":{"url":"https://music.apple.com/us/album/1234567890","id":"1234567890"}},
    {"name":"a list parameter that is too short is not a playlist id","input":{"op":"canonical","url":"https://www.youtube.com/watch?v=aaaaaaaaaaa&list=P"},"expected":{"url":"https://youtube.com/watch?v=aaaaaaaaaaa&list=P"}},
    {"name":"kind: a radio mix on another site is not infinite","input":{"op":"collectionKind","url":"https://example.com/playlist?list=RDabc"},"expected":{"kind":"playlist","infinite":false}},
    {"name":"kind: a lower-case list prefix is still a radio mix","input":{"op":"collectionKind","url":"https://www.youtube.com/watch?v=aaaaaaaaaaa&list=rdaaaaaaaaaaa"},"expected":{"infinite":true}},
    {"name":"kind: a youtube music album by browse id","input":{"op":"collectionKind","url":"https://music.youtube.com/browse/MPREb_xyz"},"expected":{"kind":"album"}},
    {"name":"a playlist without times migrates with zeros","input":{"op":"migratePlaylist","space":"music","playlist":{"id":"pl-3","name":"Old","itemIds":[]}},"expected":{"id":"pl-3","kind":"own","itemIds":[],"createdAt":0,"updatedAt":0}},
    {"name":"order: an index of 0 sorts before unknown items and ties keep their order","input":{"op":"order","ids":["x","b","a","y"],"index":{"a":0,"b":0}},"expected":{"ids":["b","a","x","y"]}},
    {"name":"due: a collection of kind own is never checked, an album with a source is","input":{"op":"due","now":1800000000000,"collections":[{"id":"own","kind":"own","sourceUrl":"https://www.youtube.com/playlist?list=PL1","follow":{"mode":"auto"}},{"id":"album","kind":"album","sourceUrl":"https://open.spotify.com/album/1A2B3C4D5E6F","follow":{"mode":"auto"}}]},"expected":{"ids":["album"]}},
    {"name":"due: exactly one interval since the last check is due","input":{"op":"due","now":1800000000000,"collections":[{"id":"edge","sourceUrl":"https://www.youtube.com/playlist?list=PL1","follow":{"mode":"auto","intervalHours":1,"lastCheckedAt":1799996400000}},{"id":"early","sourceUrl":"https://www.youtube.com/playlist?list=PL2","follow":{"mode":"auto","intervalHours":1,"lastCheckedAt":1799996400001}}]},"expected":{"ids":["edge"]}}
  ]
}
