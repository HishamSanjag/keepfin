{
  "description": "Smart space rules over library items -> the ids a smart space gathers, in library order. now = 1800000000000. Item fields: id, space (default music), kind (default audio), tags, userTags, artist, album, favorite, plays, addedDaysAgo (default 0), sourceUrl, sourceId. Rules: {field: tag|collection|space|source|artist|album|kind, values} | {field: addedWithin, days} | {field: favorite} | {field: unplayed}; match any|all; onlyKind and excludeSpaces apply after the rules. collectionsOf maps item id -> collection ids.",
  "cases": [
    {"name":"any: one rule is enough","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","tags":["jazz"]},{"id":"b","favorite":true},{"id":"c","tags":["rock"]}],"rules":{"match":"any","rules":[{"field":"tag","values":["jazz"]},{"field":"favorite"}]}},"expected":{"ids":["a","b"]}},
    {"name":"all: every rule must hit","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","tags":["jazz"]},{"id":"b","tags":["jazz"],"plays":3},{"id":"c"}],"rules":{"match":"all","rules":[{"field":"tag","values":["jazz"]},{"field":"unplayed"}]}},"expected":{"ids":["a"]}},
    {"name":"values inside one rule are ORed and tags include user tags","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","tags":["blues"]},{"id":"b","userTags":["jazz"]},{"id":"c","tags":["pop"]}],"rules":{"match":"all","rules":[{"field":"tag","values":["jazz","blues"]}]}},"expected":{"ids":["a","b"]}},
    {"name":"tag rule values ignore case","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","tags":["lofi"]},{"id":"b","userTags":["study"]},{"id":"c","tags":["rock"]}],"rules":{"match":"any","rules":[{"field":"tag","values":["LoFi","study"]}]}},"expected":{"ids":["a","b"]}},
    {"name":"all of tag and kind that no item satisfies","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","tags":["lofi"]},{"id":"b","kind":"video","userTags":["study"]}],"rules":{"match":"all","rules":[{"field":"tag","values":["lofi"]},{"field":"kind","values":["video"]}]}},"expected":{"ids":[]}},
    {"name":"artist matches without diacritics or case","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","artist":"Björk"},{"id":"b","artist":"Someone"}],"rules":{"match":"any","rules":[{"field":"artist","values":["bjork"]}]}},"expected":{"ids":["a"]}},
    {"name":"artist ignores a Topic channel suffix","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","artist":"Daft Punk - Topic"},{"id":"b","artist":"Someone"}],"rules":{"match":"any","rules":[{"field":"artist","values":["Daft Punk"]}]}},"expected":{"ids":["a"]}},
    {"name":"album matches ignoring case","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","album":"Homogenic"},{"id":"b","album":"Post"},{"id":"c"}],"rules":{"match":"any","rules":[{"field":"album","values":["HOMOGENIC"]}]}},"expected":{"ids":["a"]}},
    {"name":"collection membership","input":{"op":"smart","now":1800000000000,"collectionsOf":{"a":["col-1"],"b":["col-1","col-2"]},"items":[{"id":"a"},{"id":"b"},{"id":"c"}],"rules":{"match":"any","rules":[{"field":"collection","values":["col-2","other"]}]}},"expected":{"ids":["b"]}},
    {"name":"space rule","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","space":"gym"},{"id":"b","space":"music"},{"id":"c","space":"downloads"}],"rules":{"match":"any","rules":[{"field":"space","values":["gym","downloads"]}]}},"expected":{"ids":["a","c"]}},
    {"name":"kind rule","input":{"op":"smart","now":1800000000000,"items":[{"id":"a"},{"id":"b","kind":"video"}],"rules":{"match":"any","rules":[{"field":"kind","values":["audio"]}]}},"expected":{"ids":["a"]}},
    {"name":"source rule by provider name","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","sourceUrl":"https://www.youtube.com/watch?v=aaaaaaaaaaa","sourceId":"youtube:aaaaaaaaaaa"},{"id":"b","sourceUrl":"https://open.spotify.com/track/abcdefghij","sourceId":"spotify:abcdefghij"},{"id":"c"}],"rules":{"match":"any","rules":[{"field":"source","values":["spotify"]}]}},"expected":{"ids":["b"]}},
    {"name":"source rule youtube","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","sourceUrl":"https://www.youtube.com/watch?v=aaaaaaaaaaa","sourceId":"youtube:aaaaaaaaaaa"},{"id":"b","sourceUrl":"https://open.spotify.com/track/abcdefghij","sourceId":"spotify:abcdefghij"}],"rules":{"match":"any","rules":[{"field":"source","values":["youtube"]}]}},"expected":{"ids":["a"]}},
    {"name":"source rule youtube also covers YouTube Music downloads","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","sourceUrl":"https://music.youtube.com/watch?v=aaaaaaaaaaa","sourceId":"youtube:aaaaaaaaaaa"}],"rules":{"match":"any","rules":[{"field":"source","values":["youtube"]}]}},"expected":{"ids":["a"]}},
    {"name":"added within the last 7 days","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","addedDaysAgo":2},{"id":"b","addedDaysAgo":40},{"id":"c","addedDaysAgo":30}],"rules":{"match":"any","rules":[{"field":"addedWithin","days":7}]}},"expected":{"ids":["a"]}},
    {"name":"added exactly 7 days ago is within 7 days","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","addedDaysAgo":7},{"id":"b","addedDaysAgo":8}],"rules":{"match":"any","rules":[{"field":"addedWithin","days":7}]}},"expected":{"ids":["a"]}},
    {"name":"favorites","input":{"op":"smart","now":1800000000000,"items":[{"id":"a"},{"id":"b","favorite":true}],"rules":{"match":"any","rules":[{"field":"favorite"}]}},"expected":{"ids":["b"]}},
    {"name":"unplayed means no plays","input":{"op":"smart","now":1800000000000,"items":[{"id":"a"},{"id":"b","plays":3},{"id":"c","plays":0}],"rules":{"match":"any","rules":[{"field":"unplayed"}]}},"expected":{"ids":["a","c"]}},
    {"name":"onlyKind applies after the rules","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","kind":"video"},{"id":"b"}],"rules":{"match":"any","rules":[{"field":"unplayed"}],"onlyKind":"video"}},"expected":{"ids":["a"]}},
    {"name":"excluded spaces apply after the rules","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","space":"downloads"},{"id":"b","space":"music"}],"rules":{"match":"any","rules":[{"field":"unplayed"}],"excludeSpaces":["downloads"]}},"expected":{"ids":["b"]}},
    {"name":"no rules gather nothing","input":{"op":"smart","now":1800000000000,"items":[{"id":"a"},{"id":"b"}],"rules":{"match":"all","rules":[]}},"expected":{"ids":[]}},
    {"name":"a rule without values never matches","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","tags":["x"]}],"rules":{"match":"any","rules":[{"field":"tag","values":[]}]}},"expected":{"ids":[]}},
    {"name":"artist rule matches a credited artist in a feat. line","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","artist":"Daft Punk feat. Pharrell Williams"},{"id":"b","artist":"Someone"}],"rules":{"match":"any","rules":[{"field":"artist","values":["Pharrell Williams"]}]}},"expected":{"ids":["a"]}},
    {"name":"artist rule matches one of several artists joined by & or a comma","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","artist":"Simon & Garfunkel"},{"id":"b","artist":"Hall, Oates"},{"id":"c","artist":"Sandstorm"}],"rules":{"match":"any","rules":[{"field":"artist","values":["garfunkel","oates"]}]}},"expected":{"ids":["a","b"]}},
    {"name":"artist rule does not split inside a word","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","artist":"Sandy Alex"},{"id":"b","artist":"Brandon"}],"rules":{"match":"any","rules":[{"field":"artist","values":["and","y"]}]}},"expected":{"ids":[]}},
    {"name":"artist rule falls back to the album artist","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","albumArtist":"Radiohead"},{"id":"b","artist":"Other","albumArtist":"Radiohead"}],"rules":{"match":"any","rules":[{"field":"artist","values":["radiohead"]}]}},"expected":{"ids":["a"]}},
    {"name":"album rule ignores accents on both sides","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","album":"Björk Live"},{"id":"b","album":"Post"}],"rules":{"match":"any","rules":[{"field":"album","values":["Björk Live"]}]}},"expected":{"ids":["a"]}},
    {"name":"collection ids ignore case","input":{"op":"smart","now":1800000000000,"collectionsOf":{"a":["COL-1"]},"items":[{"id":"a"},{"id":"b"}],"rules":{"match":"any","rules":[{"field":"collection","values":["col-1"]}]}},"expected":{"ids":["a"]}},
    {"name":"space ids ignore case","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","space":"Gym"},{"id":"b","space":"music"}],"rules":{"match":"any","rules":[{"field":"space","values":["gym"]}]}},"expected":{"ids":["a"]}},
    {"name":"onlyKind and excluded spaces both have to pass","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","kind":"video","space":"downloads"},{"id":"b","kind":"video","space":"videos"},{"id":"c","space":"videos"}],"rules":{"match":"any","rules":[{"field":"unplayed"}],"onlyKind":"video","excludeSpaces":["downloads"]}},"expected":{"ids":["b"]}},
    {"name":"source rule needs the whole name: spot does not match spotify","input":{"op":"smart","now":1800000000000,"items":[{"id":"a","sourceUrl":"https://open.spotify.com/track/abcdefghij","sourceId":"spotify:abcdefghij"}],"rules":{"match":"any","rules":[{"field":"source","values":["spot"]}]}},"expected":{"ids":[]}}
  ]
}
