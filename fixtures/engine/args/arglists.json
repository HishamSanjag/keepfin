{
  "description": "The full format-and-options argument list the download engine receives, in order. Tool paths, network, cookies and output flags are added by each app around it.",
  "cases": [
    {"name":"best mp4, nothing else","input":{"op":"args","format":{"type":"video","codec":"auto","container":"mp4"},"options":{}},"expected":["-f","bv*+ba/b","-S","res,fps,hdr:sdr,vcodec:h264,acodec:aac","--merge-output-format","mp4","--remux-video","mp4"]},
    {"name":"1080p60 av1 mkv with every extra","input":{"op":"args","format":{"type":"video","maxHeight":1080,"fps":60,"codec":"av1","container":"mkv"},"options":{"subtitles":{"enabled":true,"languages":"en.*,ar","auto":true,"embed":false},"embedThumbnail":true,"embedMetadata":true,"embedChapters":true,"sponsorBlock":"mark","section":{"start":0.5,"end":10.25}}},"expected":["-f","bv*+ba/b","-S","res:1080,fps:60,hdr:sdr,vcodec:av01","--merge-output-format","mkv","--remux-video","mkv","--write-subs","--sub-langs","en.*,ar","--write-auto-subs","--convert-subs","srt","--embed-thumbnail","--convert-thumbnails","jpg","--embed-metadata","--embed-chapters","--sponsorblock-mark","all","--download-sections","*0.5-10.25"]},
    {"name":"exact webm ids with embedded subtitles and removed sponsors","input":{"op":"args","format":{"type":"video","formatId":"303","audioFormatId":"251","codec":"auto","container":"webm"},"options":{"subtitles":{"enabled":true,"languages":"en","auto":false,"embed":true},"embedThumbnail":true,"sponsorBlock":"remove"}},"expected":["-f","303+251/303/bv*[ext=webm]+ba[ext=webm]/bv*+ba/b","-S","res,fps,vcodec:vp9,acodec:opus","--merge-output-format","webm/mkv","--write-subs","--sub-langs","en","--embed-subs","--sponsorblock-remove","sponsor,selfpromo,interaction"]},
    {"name":"exact mp4 video id gets the audio fallback chain","input":{"op":"args","format":{"type":"video","formatId":"299","codec":"h264","container":"mp4"},"options":{"embedThumbnail":true}},"expected":["-f","299+ba[ext=m4a]/299+ba/299/bv*+ba/b","-S","res,fps,vcodec:h264,acodec:aac","--merge-output-format","mp4","--remux-video","mp4","--embed-thumbnail","--convert-thumbnails","jpg"]},
    {"name":"mp3 320 from an exact stream with a square cover","input":{"op":"args","format":{"type":"audio","target":"mp3","quality":"320","formatId":"251"},"options":{"embedThumbnail":true,"embedMetadata":true},"squareCover":true},"expected":["-f","251/ba/b","-x","--audio-format","mp3","--audio-quality","320K","--embed-thumbnail","--convert-thumbnails","jpg","--ppa","ThumbnailsConvertor+FFmpeg_o:-c:v mjpeg -qmin 1 -qscale:v 1 -vf crop=\"'if(gt(ih,iw),iw,ih)':'if(gt(iw,ih),ih,iw)'\"","--embed-metadata"]},
    {"name":"m4a split by chapters with the chapter template","input":{"op":"args","format":{"type":"audio","target":"m4a","quality":"best"},"options":{"splitChapters":true,"writeDescription":true,"writeInfoJson":true,"embedChapters":true},"chapterTemplate":"C:/out/%(section_title)s.%(ext)s"},"expected":["-f","ba[ext=m4a]/ba[acodec^=mp4a]/ba/b","-x","--audio-format","m4a","--audio-quality","0","--embed-chapters","--split-chapters","-o","chapter:C:/out/%(section_title)s.%(ext)s","--write-description","--write-info-json"],"platforms":["desktop"]},
    {"name":"flac, wav and original ignore the quality","input":{"op":"args","format":{"type":"audio","target":"flac","quality":"128"},"options":{}},"expected":["-f","ba/b","-x","--audio-format","flac"]},
    {"name":"wav keeps no chapters or cover","input":{"op":"args","format":{"type":"audio","target":"wav","quality":"best"},"options":{"embedChapters":true,"embedThumbnail":true}},"expected":["-f","ba/b","-x","--audio-format","wav"]},
    {"name":"original audio from an exact stream","input":{"op":"args","format":{"type":"audio","target":"original","quality":"best","formatId":"140"},"options":{"embedMetadata":true}},"expected":["-f","140/ba/b","-x","--embed-metadata"]},
    {"name":"a saved thumbnail without an embedded one is converted to jpg","input":{"op":"args","format":{"type":"video","codec":"auto","container":"mkv"},"options":{"writeThumbnail":true}},"expected":["-f","bv*+ba/b","-S","res,fps,hdr:sdr","--merge-output-format","mkv","--remux-video","mkv","--write-thumbnail","--convert-thumbnails","jpg"]},
    {"name":"a saved thumbnail next to an embedded one converts once","input":{"op":"args","format":{"type":"video","codec":"auto","container":"mp4"},"options":{"writeThumbnail":true,"embedThumbnail":true}},"expected":["-f","bv*+ba/b","-S","res,fps,hdr:sdr,vcodec:h264,acodec:aac","--merge-output-format","mp4","--remux-video","mp4","--embed-thumbnail","--convert-thumbnails","jpg","--write-thumbnail"]},
    {"name":"opus with cover art (needs the optional module on phones)","input":{"op":"args","format":{"type":"audio","target":"opus","quality":"best"},"options":{"embedThumbnail":true}},"expected":["-f","ba[acodec=opus]/ba/b","-x","--audio-format","opus","--audio-quality","0","--embed-thumbnail","--convert-thumbnails","jpg"],"platforms":["desktop"]},
