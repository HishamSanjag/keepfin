    {"name":"an open-ended section","input":{"op":"args","format":{"type":"video","maxHeight":720,"codec":"auto","container":"mp4"},"options":{"section":{"start":90}}},"expected":["-f","bv*+ba/b","-S","res:720,fps,hdr:sdr,vcodec:h264,acodec:aac","--merge-output-format","mp4","--remux-video","mp4","--download-sections","*90-inf"]},
    {"name":"opus with cover art, without the optional module (phones)","input":{"op":"args","format":{"type":"audio","target":"opus","quality":"best"},"options":{"embedThumbnail":true}},"expected":["-f","ba[acodec=opus]/ba/b","-x","--audio-format","opus","--audio-quality","0"],"platforms":["android"]},
    {"name":"original audio with cover art, without the optional module (phones)","input":{"op":"args","format":{"type":"audio","target":"original","quality":"best"},"options":{"embedThumbnail":true,"embedMetadata":true}},"expected":["-f","ba/b","-x","--embed-metadata"],"platforms":["android"]},
