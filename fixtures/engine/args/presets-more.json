    {"name":"1440","input":{"op":"preset","preset":"1440"},"expected":{"type":"video","maxHeight":1440,"codec":"auto","container":"mp4"}},
    {"name":"720","input":{"op":"preset","preset":"720"},"expected":{"type":"video","maxHeight":720,"codec":"auto","container":"mp4"}},
