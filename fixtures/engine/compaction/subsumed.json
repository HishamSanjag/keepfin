{"name":"merged-file-covers-the-pile","input":{"op":"subsumed","segments":[{"actor":"a","first":1,"last":2},{"actor":"a","first":3,"last":4},{"actor":"a","first":1,"last":4}]},"expected":{"subsumed":[[0,2],[1,2]]}},
