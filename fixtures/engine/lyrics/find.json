{
  "description": "Find lyrics on a song that has none: which answers mean the service could not help just now (busy), how a search that ended is named, and the plain line for it. Busy and not found read differently.",
  "cases": [
    {"name":"timed: an lrc line","input":{"op":"isTimed","text":"[00:01.50]First line"},"expected":true},
    {"name":"timed: a later line","input":{"op":"isTimed","text":"[ar:Someone]\n[01:02.00]Line"},"expected":true},
    {"name":"timed: plain words","input":{"op":"isTimed","text":"First line\nSecond [line]"},"expected":false},
    {"name":"timed: an info tag alone","input":{"op":"isTimed","text":"[ar:Someone]"},"expected":false},
    {"name":"prefer: a timed exact match","input":{"op":"preferTimed","exact":"[00:01.00]A","found":"[00:02.00]B"},"expected":"[00:01.00]A"},
    {"name":"prefer: timed search over plain exact","input":{"op":"preferTimed","exact":"A","found":"[00:02.00]B"},"expected":"[00:02.00]B"},
    {"name":"prefer: plain exact when the search has no timing","input":{"op":"preferTimed","exact":"A","found":"B"},"expected":"A"},
    {"name":"prefer: plain exact when the search found nothing","input":{"op":"preferTimed","exact":"A"},"expected":"A"},
    {"name":"prefer: search alone","input":{"op":"preferTimed","found":"B"},"expected":"B"},
    {"name":"prefer: nothing","input":{"op":"preferTimed"},"expected":null},
    {"name":"no answer at all is busy","input":{"op":"busy","status":null},"expected":true},
    {"name":"429 is busy","input":{"op":"busy","status":429},"expected":true},
    {"name":"500 is busy","input":{"op":"busy","status":500},"expected":true},
    {"name":"503 is busy","input":{"op":"busy","status":503},"expected":true},
    {"name":"404 is a real not found","input":{"op":"busy","status":404},"expected":false},
    {"name":"200 is an answer","input":{"op":"busy","status":200},"expected":false},
    {"name":"400 is a refusal, not busy","input":{"op":"busy","status":400},"expected":false},
    {"name":"lyrics came","input":{"op":"outcome","found":true,"gaveUpOnBusy":false},"expected":"found"},
    {"name":"lyrics came although a request was busy","input":{"op":"outcome","found":true,"gaveUpOnBusy":true},"expected":"found"},
    {"name":"nothing and every answer was final","input":{"op":"outcome","found":false,"gaveUpOnBusy":false},"expected":"none"},
    {"name":"nothing and a request never got an answer","input":{"op":"outcome","found":false,"gaveUpOnBusy":true},"expected":"busy"},
    {"name":"found","input":{"op":"outcomeWords","outcome":"found"},"expected":"Lyrics added."},
    {"name":"none line","input":{"op":"outcomeWords","outcome":"none"},"expected":"No lyrics found"},
    {"name":"busy line","input":{"op":"outcomeWords","outcome":"busy"},"expected":"Could not reach the lyrics service. Try again later."},
    {"name":"the action","input":{"op":"findWords"},"expected":"Find lyrics"}
  ]
}
