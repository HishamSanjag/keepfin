{
  "description": "How two recordings are the same, strictest tier first: a shared source id, the same ISRC, the same bytes (contentKey), then the metadata test. A recording is {title, artist?, album?, duration?, sourceIds?, contentKey?, isrc?}. `compare` -> {tier} (source, isrc, content, metadata or null). ISRCs compare without hyphens or spaces and ignoring case; a malformed one is ignored; differing ISRCs do not rule out a metadata match. `existing` items and probes may carry an isrc too.",
  "cases": [
    {"name":"a shared source id wins whatever the metadata says","input":{"op":"compare","a":{"title":"A","artist":"Z","sourceIds":["youtube:1"]},"b":{"title":"Other","artist":"Q","sourceIds":["youtube:1","spotify:2"]}},"expected":{"tier":"source"}},
    {"name":"source ids that do not overlap do not match","input":{"op":"compare","a":{"title":"A","sourceIds":["youtube:1"]},"b":{"title":"B","sourceIds":["youtube:2"]}},"expected":{"tier":null}},
    {"name":"the same ISRC is the same recording whatever the title and length","input":{"op":"compare","a":{"title":"Song","artist":"A","duration":100,"isrc":"GBAYE0601498"},"b":{"title":"Another title","artist":"B","duration":300,"isrc":"GBAYE0601498"}},"expected":{"tier":"isrc"}},
    {"name":"ISRCs compare ignoring hyphens, spaces and case","input":{"op":"compare","a":{"title":"x","isrc":"gb-aye-06-01498"},"b":{"title":"y","isrc":"GBAYE0601498"}},"expected":{"tier":"isrc"}},
    {"name":"a malformed ISRC is ignored","input":{"op":"compare","a":{"title":"x","isrc":"1234"},"b":{"title":"y","isrc":"1234"}},"expected":{"tier":null}},
    {"name":"a source id outranks an ISRC","input":{"op":"compare","a":{"title":"x","sourceIds":["youtube:1"],"isrc":"GBAYE0601498"},"b":{"title":"y","sourceIds":["youtube:1"],"isrc":"GBAYE0601498"}},"expected":{"tier":"source"}},
    {"name":"an ISRC outranks the same bytes","input":{"op":"compare","a":{"title":"x","contentKey":"k","isrc":"GBAYE0601498"},"b":{"title":"y","contentKey":"k","isrc":"GBAYE0601498"}},"expected":{"tier":"isrc"}},
    {"name":"the same bytes are the same recording","input":{"op":"compare","a":{"title":"A","artist":"Z","contentKey":"k"},"b":{"title":"Q","artist":"Other","contentKey":"k"}},"expected":{"tier":"content"}},
    {"name":"different bytes alone do not match","input":{"op":"compare","a":{"title":"A","contentKey":"k1"},"b":{"title":"B","contentKey":"k2"}},"expected":{"tier":null}},
    {"name":"the same bytes outrank the metadata test","input":{"op":"compare","a":{"title":"Song","artist":"Band","duration":200,"contentKey":"k"},"b":{"title":"Song","artist":"Band","duration":200,"contentKey":"k"}},"expected":{"tier":"content"}},
    {"name":"metadata is the last tier","input":{"op":"compare","a":{"title":"Song (Official Audio)","artist":"Band - Topic","duration":200},"b":{"title":"Song","artist":"Band","duration":201.5}},"expected":{"tier":"metadata"}},
    {"name":"differing ISRCs do not veto a metadata match","input":{"op":"compare","a":{"title":"Song","artist":"Band","duration":200,"isrc":"GBAYE0601498"},"b":{"title":"Song","artist":"Band","duration":200,"isrc":"GBAYE0601499"}},"expected":{"tier":"metadata"}},
    {"name":"nothing in common","input":{"op":"compare","a":{"title":"Song","artist":"Band","duration":200},"b":{"title":"Song","artist":"Other","duration":200}},"expected":{"tier":null}},
    {"name":"an ISRC match finds a library item with no source id","input":{"op":"existing","items":[{"id":"1","space":"music","title":"Different title","artist":"Band","duration":250,"isrc":"GBAYE0601498"}],"probe":{"isrc":"GBAYE0601498"}},"expected":{"itemId":"1","by":"isrc"}},
    {"name":"a missing item never matches by ISRC","input":{"op":"existing","items":[{"id":"1","space":"music","title":"Song","isrc":"GBAYE0601498","missing":true}],"probe":{"isrc":"GBAYE0601498"}},"expected":{"itemId":null,"by":null}},
    {"name":"a source id match is preferred over an earlier ISRC match","input":{"op":"existing","items":[{"id":"1","space":"music","title":"Song","isrc":"GBAYE0601498"},{"id":"2","space":"music","title":"Other","sourceId":"youtube:z"}],"probe":{"sourceId":"youtube:z","isrc":"GBAYE0601498"}},"expected":{"itemId":"2","by":"source"}},
    {"name":"an ISRC match is preferred over an earlier metadata match","input":{"op":"existing","items":[{"id":"1","space":"music","title":"Song","artist":"A","duration":100},{"id":"2","space":"music","title":"Renamed","artist":"A","duration":100,"isrc":"GBAYE0601498"}],"probe":{"isrc":"GBAYE0601498","recording":{"artist":"A","title":"Song","duration":100}}},"expected":{"itemId":"2","by":"isrc"}}
  ]
}
