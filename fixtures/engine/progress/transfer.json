{
  "description": "Engine progress steps -> aggregated transfer progress. Each step is a neutral progress event or a raw log line; the runner renders it in the platform's own wire format. Checkpoints {after: step} compare percent/speed/eta within 1.",
  "cases": [
    {"name":"a single stream reports percent, speed, eta and bytes","input":{"steps":[{"type":"progress","status":"downloading","formatId":"18","downloaded":5000000,"total":10000000,"speed":2500000,"eta":2}]},"expected":[{"after":0,"percent":50,"downloadedBytes":5000000,"totalBytes":10000000,"speed":2500000,"eta":2,"processing":false,"phase":null}]},
    {"name":"an estimated total is used when the exact one is unknown","input":{"steps":[{"type":"progress","status":"downloading","formatId":"18","downloaded":250,"total":null,"estimate":1000,"speed":50,"eta":15}]},"expected":[{"after":0,"percent":25,"downloadedBytes":250,"totalBytes":1000}]},
    {"name":"two streams with known sizes aggregate by bytes","input":{"steps":[{"type":"line","text":"[info] abc: Downloading 1 format(s): 299+140"},{"type":"line","text":"[download] Destination: /x/a.f299.mp4"},{"type":"progress","status":"downloading","formatId":"299","downloaded":100,"total":200,"speed":10,"eta":10},{"type":"progress","status":"finished","formatId":"299","downloaded":200,"total":200},{"type":"line","text":"[download] Destination: /x/a.f140.m4a"},{"type":"progress","status":"downloading","formatId":"140","downloaded":25,"total":100,"speed":10,"eta":10}]},"expected":[{"after":5,"percent":75,"downloadedBytes":225,"totalBytes":300}]},
    {"name":"inspected stream sizes drive percent and eta","input":{"streamSizes":{"140":200000,"299":800000},"steps":[{"type":"line","text":"[info] abc: Downloading 1 format(s): 299+140"},{"type":"progress","status":"downloading","formatId":"299","downloaded":400000,"total":null,"estimate":null,"speed":100000,"eta":null}]},"expected":[{"after":1,"percent":40,"downloadedBytes":400000,"totalBytes":1000000,"eta":6}]},
    {"name":"percent stays below 100 while post-processing has not run","input":{"streamSizes":{"1":100},"steps":[{"type":"line","text":"[info] abc: Downloading 1 format(s): 1"},{"type":"progress","status":"downloading","formatId":"1","downloaded":100,"total":null,"estimate":null,"speed":1,"eta":null}]},"expected":[{"after":1,"percent":99}]},
    {"name":"percent never goes backwards","input":{"streamSizes":{"1":100},"steps":[{"type":"line","text":"[info] abc: Downloading 1 format(s): 1"},{"type":"progress","status":"downloading","formatId":"1","downloaded":60,"total":null,"estimate":null,"speed":1,"eta":null},{"type":"progress","status":"downloading","formatId":"1","downloaded":40,"total":null,"estimate":null,"speed":1,"eta":null}]},"expected":[{"after":1,"percent":60},{"after":2,"percent":60}]},
    {"name":"fragment counts drive percent when no size is known (desktop)","platforms":["desktop"],"reason":"Desktop reads fragment counts from its progress template.","input":{"steps":[{"type":"progress","status":"downloading","formatId":"hls-1","downloaded":1000,"total":null,"estimate":null,"speed":500,"eta":null,"fragmentIndex":3,"fragmentCount":10}]},"expected":[{"after":0,"percent":30}]},
    {"name":"fragment counts drive percent when no size is known (android)","platforms":["android"],"reason":"The Android engine output template has no fragment fields, so a stream with no sizes stays at 0%.","input":{"steps":[{"type":"progress","status":"downloading","formatId":"hls-1","downloaded":1000,"total":null,"estimate":null,"speed":500,"eta":null,"fragmentIndex":3,"fragmentCount":10}]},"expected":[{"after":0,"percent":0}]},
    {"name":"log noise changes nothing","input":{"steps":[{"type":"line","text":""},{"type":"line","text":"WARNING: something"}]},"expected":[{"after":1,"percent":0,"downloadedBytes":null,"totalBytes":null,"phase":null,"processing":false}]},
    {"name":"aria2c lines (multi-connection transfers)","platforms":["android"],"input":{"steps":[{"type":"line","text":"[#2089b0 12MiB/150MiB(8%) CN:8 DL:5.2MiB ETA:26s]"}]},"expected":[{"after":0,"percent":8,"downloadedBytes":12582912,"totalBytes":157286400,"speed":5452595,"eta":26}]},
    {"name":"streams without sizes count equally","input":{"steps":[{"type":"line","text":"[info] abc: Downloading 1 format(s): 299+140"},{"type":"progress","status":"downloading","formatId":"299","downloaded":100,"total":null,"estimate":null,"speed":10,"eta":null},{"type":"progress","status":"finished","formatId":"299","downloaded":200,"total":200},{"type":"progress","status":"downloading","formatId":"140","downloaded":5,"total":null,"estimate":null,"speed":10,"eta":null}]},"expected":[{"after":3,"percent":50}]},
    {"name":"a stream that was already downloaded counts as done","platforms":["android"],"reason":"Desktop used to ignore the line; the core counts it on both, which only makes desktop's percent more accurate.","input":{"steps":[{"type":"line","text":"[info] abc: Downloading 1 format(s): 299+140"},{"type":"line","text":"[download] /x/a.f299.mp4 has already been downloaded"},{"type":"progress","status":"downloading","formatId":"140","downloaded":25,"total":100,"speed":10,"eta":10}]},"expected":[{"after":2,"percent":62.5}]},
    {"name":"aria2c: two streams aggregate by bytes","platforms":["android"],"input":{"steps":[{"type":"line","text":"[info] abc: Downloading 1 format(s): 299+140"},{"type":"line","text":"[download] Destination: /x/a.f299.mp4"},{"type":"line","text":"[#a1b2c3 50MiB/100MiB(50%) CN:8 DL:5MiB ETA:10s]"},{"type":"line","text":"[download] Destination: /x/a.f140.m4a"},{"type":"line","text":"[#d4e5f6 10MiB/20MiB(50%) CN:8 DL:5MiB ETA:2s]"}]},"expected":[{"after":2,"percent":25,"downloadedBytes":52428800},{"after":4,"percent":92,"downloadedBytes":115343360,"totalBytes":125829120,"eta":2}]}
  ]
}
