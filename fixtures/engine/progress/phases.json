{
  "description": "Post-processing log lines -> a phase key (the visible wording differs per platform; keys are merge, extract-audio, embed-cover, convert-cover, metadata, embed-subs, sponsorblock, modify-chapters, split-chapters, fixup, remux, convert-video, move-files). Download progress clears the phase.",
  "cases": [
    {"name":"merging after the download finished","input":{"steps":[{"type":"progress","status":"finished","formatId":"1","downloaded":10,"total":10},{"type":"line","text":"[Merger] Merging formats into \"/x/a.mp4\""}]},"expected":[{"after":1,"phase":"merge","processing":true,"speed":null,"eta":null}]},
    {"name":"audio conversion names the target","input":{"audioTarget":"mp3","steps":[{"type":"progress","status":"finished","formatId":"1","downloaded":10,"total":10},{"type":"line","text":"[ExtractAudio] Destination: /x/a.mp3"}]},"expected":[{"after":1,"phase":"extract-audio","processing":true}]},
    {"name":"cover art embedding","input":{"steps":[{"type":"progress","status":"finished","formatId":"1","downloaded":10,"total":10},{"type":"line","text":"[EmbedThumbnail] ffmpeg: Adding thumbnail to \"/x/a.mp3\""}]},"expected":[{"after":1,"phase":"embed-cover","processing":true}]},
    {"name":"cover art preparation","input":{"steps":[{"type":"progress","status":"finished","formatId":"1","downloaded":10,"total":10},{"type":"line","text":"[ThumbnailsConvertor] Converting thumbnail \"/x/a.webp\" to jpg"}]},"expected":[{"after":1,"phase":"convert-cover","processing":true}]},
    {"name":"metadata writing","input":{"steps":[{"type":"progress","status":"finished","formatId":"1","downloaded":10,"total":10},{"type":"line","text":"[Metadata] Adding metadata to \"/x/a.mp3\""}]},"expected":[{"after":1,"phase":"metadata","processing":true}]},
    {"name":"subtitle embedding","input":{"steps":[{"type":"progress","status":"finished","formatId":"1","downloaded":10,"total":10},{"type":"line","text":"[EmbedSubtitle] Embedding subtitles in \"/x/a.mkv\""}]},"expected":[{"after":1,"phase":"embed-subs","processing":true}]},
    {"name":"container fix-up","input":{"steps":[{"type":"progress","status":"finished","formatId":"1","downloaded":10,"total":10},{"type":"line","text":"[FixupM4a] Correcting container of \"/x/a.m4a\""}]},"expected":[{"after":1,"phase":"fixup","processing":true}]},
    {"name":"sponsor segment lookup","input":{"steps":[{"type":"progress","status":"finished","formatId":"1","downloaded":10,"total":10},{"type":"line","text":"[SponsorBlock] Fetching SponsorBlock segments"}]},"expected":[{"after":1,"phase":"sponsorblock","processing":true}]},
    {"name":"a remux of a finished download","input":{"steps":[{"type":"progress","status":"finished","formatId":"1","downloaded":10,"total":10},{"type":"line","text":"[VideoRemuxer] Remuxing video from webm to mp4"}]},"expected":[{"after":1,"phase":"remux","processing":true}]},
    {"name":"an extractor log line is not a phase","input":{"steps":[{"type":"line","text":"[youtube] Extracting URL: https://www.youtube.com/watch?v=abcdefghijk"}]},"expected":[{"after":0,"phase":null,"processing":false}]},
    {"name":"moving the finished file is not shown as a phase","input":{"steps":[{"type":"line","text":"[MoveFiles] Moving file \"/tmp/a.mp4\" to \"/x/a.mp4\""}]},"expected":[{"after":0,"phase":null,"processing":false}]},
    {"name":"new download progress clears the phase","input":{"steps":[{"type":"progress","status":"finished","formatId":"1","downloaded":10,"total":10},{"type":"line","text":"[Merger] Merging formats into \"/x/a.mp4\""},{"type":"progress","status":"downloading","formatId":"2","downloaded":1,"total":10,"speed":1,"eta":9}]},"expected":[{"after":2,"phase":null,"processing":false}]},
    {"name":"removing sponsor segments","input":{"steps":[{"type":"progress","status":"finished","formatId":"1","downloaded":10,"total":10},{"type":"line","text":"[ModifyChapters] Removing chapters from \"/x/a.mp4\""}]},"expected":[{"after":1,"phase":"modify-chapters","processing":true}]},
    {"name":"splitting chapters","input":{"steps":[{"type":"progress","status":"finished","formatId":"1","downloaded":10,"total":10},{"type":"line","text":"[SplitChapters] Splitting video by chapters; 3 chapters found"}]},"expected":[{"after":1,"phase":"split-chapters","processing":true}]},
    {"name":"video conversion","input":{"steps":[{"type":"progress","status":"finished","formatId":"1","downloaded":10,"total":10},{"type":"line","text":"[VideoConvertor] Converting video from webm to mp4"}]},"expected":[{"after":1,"phase":"convert-video","processing":true}]},
    {"name":"subtitle conversion","input":{"steps":[{"type":"progress","status":"finished","formatId":"1","downloaded":10,"total":10},{"type":"line","text":"[SubtitlesConvertor] Converting subtitles"}]},"expected":[{"after":1,"phase":"convert-subs","processing":true}]},
    {"name":"a parsed-metadata step counts as metadata","platforms":["android"],"reason":"Only Android's old matcher knew this prefix; desktop never printed it.","input":{"steps":[{"type":"progress","status":"finished","formatId":"1","downloaded":10,"total":10},{"type":"line","text":"[MetadataParser] Parsed title from \"%(title)s\""}]},"expected":[{"after":1,"phase":"metadata","processing":true}]},
    {"name":"older container fix-up names","platforms":["android"],"reason":"Only Android's old matcher knew this prefix.","input":{"steps":[{"type":"progress","status":"finished","formatId":"1","downloaded":10,"total":10},{"type":"line","text":"[FFmpegFixupM4a] Correcting container of \"/x/a.m4a\""}]},"expected":[{"after":1,"phase":"fixup","processing":true}]}
  ]
}
