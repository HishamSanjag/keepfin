{
  "description": "The ordered steps of a finished job and what a failure of each means (issue #9). Lyrics come before saving; a failed save marks the job Not saved; a video the song cannot take is saved as an ordinary download; every path joins the playlist; a recording already there is notified as such.",
  "cases": [
    {"name":"a song: lyrics first, then save, cover, notify","input":{"op":"plan","audio":true,"lyrics":true},"expected":{"steps":[{"kind":"lyrics","onFailure":"continue","fallback":false},{"kind":"save","onFailure":"notSaved","fallback":false},{"kind":"cover","onFailure":"continue","fallback":false},{"kind":"notify","onFailure":"continue","fallback":false},{"kind":"settleVideos","onFailure":"continue","fallback":false}]}},
    {"name":"a song with the lyrics setting off skips lyrics","input":{"op":"plan","audio":true},"expected":{"steps":[{"kind":"save","onFailure":"notSaved","fallback":false},{"kind":"cover","onFailure":"continue","fallback":false},{"kind":"notify","onFailure":"continue","fallback":false},{"kind":"settleVideos","onFailure":"continue","fallback":false}]}},
    {"name":"a video never gets lyrics","input":{"op":"plan","lyrics":true},"expected":{"steps":[{"kind":"save","onFailure":"notSaved","fallback":false},{"kind":"cover","onFailure":"continue","fallback":false},{"kind":"notify","onFailure":"continue","fallback":false},{"kind":"settleVideos","onFailure":"continue","fallback":false}]}},
    {"name":"a song joins the playlist chosen in the review","input":{"op":"plan","audio":true,"lyrics":true,"playlist":true},"expected":{"steps":[{"kind":"lyrics","onFailure":"continue","fallback":false},{"kind":"save","onFailure":"notSaved","fallback":false},{"kind":"joinPlaylist","onFailure":"continue","fallback":false},{"kind":"cover","onFailure":"continue","fallback":false},{"kind":"notify","onFailure":"continue","fallback":false},{"kind":"settleVideos","onFailure":"continue","fallback":false}]}},
    {"name":"a video joins a playlist too","input":{"op":"plan","playlist":true},"expected":{"steps":[{"kind":"save","onFailure":"notSaved","fallback":false},{"kind":"joinPlaylist","onFailure":"continue","fallback":false},{"kind":"cover","onFailure":"continue","fallback":false},{"kind":"notify","onFailure":"continue","fallback":false},{"kind":"settleVideos","onFailure":"continue","fallback":false}]}},
    {"name":"a music video goes beside its song, or is saved as an ordinary download","input":{"op":"plan","video":"attach"},"expected":{"steps":[{"kind":"attachVideo","onFailure":"saveOrdinary","fallback":false},{"kind":"save","onFailure":"notSaved","fallback":true},{"kind":"cover","onFailure":"continue","fallback":false},{"kind":"notify","onFailure":"continue","fallback":false},{"kind":"settleVideos","onFailure":"continue","fallback":false}]}},
    {"name":"a music video beside its song joins the playlist","input":{"op":"plan","video":"attach","playlist":true},"expected":{"steps":[{"kind":"attachVideo","onFailure":"saveOrdinary","fallback":false},{"kind":"save","onFailure":"notSaved","fallback":true},{"kind":"joinPlaylist","onFailure":"continue","fallback":false},{"kind":"cover","onFailure":"continue","fallback":false},{"kind":"notify","onFailure":"continue","fallback":false},{"kind":"settleVideos","onFailure":"continue","fallback":false}]}},
    {"name":"a music video before its song waits","input":{"op":"plan","video":"wait","playlist":true},"expected":{"steps":[{"kind":"waitForSong","onFailure":"continue","fallback":false},{"kind":"cover","onFailure":"continue","fallback":false},{"kind":"notify","onFailure":"continue","fallback":false},{"kind":"settleVideos","onFailure":"continue","fallback":false}]}},
    {"name":"a music video with no song is an ordinary download","input":{"op":"plan","video":"ordinary"},"expected":{"steps":[{"kind":"save","onFailure":"notSaved","fallback":false},{"kind":"cover","onFailure":"continue","fallback":false},{"kind":"notify","onFailure":"continue","fallback":false},{"kind":"settleVideos","onFailure":"continue","fallback":false}]}},
    {"name":"the older library has no song to hold a video, so it is an ordinary download","input":{"op":"plan","video":"attach","library":"legacy"},"expected":{"steps":[{"kind":"save","onFailure":"notSaved","fallback":false},{"kind":"cover","onFailure":"continue","fallback":false},{"kind":"notify","onFailure":"continue","fallback":false},{"kind":"settleVideos","onFailure":"continue","fallback":false}]}},
    {"name":"the older library joins the playlist as well","input":{"op":"plan","audio":true,"playlist":true,"library":"legacy"},"expected":{"steps":[{"kind":"save","onFailure":"notSaved","fallback":false},{"kind":"joinPlaylist","onFailure":"continue","fallback":false},{"kind":"cover","onFailure":"continue","fallback":false},{"kind":"notify","onFailure":"continue","fallback":false},{"kind":"settleVideos","onFailure":"continue","fallback":false}]}},
    {"name":"the older library saves a waiting video at once","input":{"op":"plan","video":"wait","library":"legacy"},"expected":{"steps":[{"kind":"save","onFailure":"notSaved","fallback":false},{"kind":"cover","onFailure":"continue","fallback":false},{"kind":"notify","onFailure":"continue","fallback":false},{"kind":"settleVideos","onFailure":"continue","fallback":false}]}},
    {"name":"a recording that was already there: join the playlist, say it is there","input":{"op":"plan","audio":true,"lyrics":true,"existing":true,"hasFile":false,"playlist":true},"expected":{"steps":[{"kind":"joinPlaylist","onFailure":"continue","fallback":false},{"kind":"notifyExisting","onFailure":"continue","fallback":false},{"kind":"settleVideos","onFailure":"continue","fallback":false}]}},
    {"name":"a recording that was already there, no playlist","input":{"op":"plan","audio":true,"existing":true,"hasFile":false},"expected":{"steps":[{"kind":"notifyExisting","onFailure":"continue","fallback":false},{"kind":"settleVideos","onFailure":"continue","fallback":false}]}},
    {"name":"a recording that was already there ignores a video fate","input":{"op":"plan","existing":true,"hasFile":false,"video":"attach"},"expected":{"steps":[{"kind":"notifyExisting","onFailure":"continue","fallback":false},{"kind":"settleVideos","onFailure":"continue","fallback":false}]}}
  ]
}
