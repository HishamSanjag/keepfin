{
  "description": "Pasted-link validation with the normalised link (`href`), as the desktop returned it before the shared core. The text of the error differs per app, so only validity and the link are compared.",
  "cases": [
    {"name":"validateUrl: an upper-case link is normalised","input":{"op":"validateUrl","value":"HTTPS://EXAMPLE.com/Path"},"expected":{"valid":true,"href":"https://example.com/Path"}},
    {"name":"validateUrl: the default port is dropped","input":{"op":"validateUrl","value":"https://example.com:443/a"},"expected":{"valid":true,"href":"https://example.com/a"}},
    {"name":"validateUrl: a missing path gets a slash","input":{"op":"validateUrl","value":"https://example.com"},"expected":{"valid":true,"href":"https://example.com/"}},
    {"name":"validateUrl: spaces in the path are encoded","input":{"op":"validateUrl","value":"https://example.com/a b"},"expected":{"valid":true,"href":"https://example.com/a%20b"}},
    {"name":"validateUrl: a space in the query is encoded","input":{"op":"validateUrl","value":"https://example.com/a?q=a b"},"expected":{"valid":true,"href":"https://example.com/a?q=a%20b"}},
    {"name":"validateUrl: an IDN host becomes punycode","input":{"op":"validateUrl","value":"https://bücher.example/a"},"expected":{"valid":true,"href":"https://xn--bcher-kva.example/a"}},
    {"name":"validateUrl: an empty user info is accepted and dropped","input":{"op":"validateUrl","value":"https://@example.com/a"},"expected":{"valid":true,"href":"https://example.com/a"}},
    {"name":"validateUrl: an empty password is still a credential","input":{"op":"validateUrl","value":"https://user:@example.com/a"},"expected":{"valid":false}},
    {"name":"validateUrl: a user name is a credential","input":{"op":"validateUrl","value":"https://user@example.com/a"},"expected":{"valid":false}},
    {"name":"validateUrl: an unparsable port is rejected","input":{"op":"validateUrl","value":"https://example.com:99999/a"},"expected":{"valid":false}},
    {"name":"validateUrl: no scheme is rejected","input":{"op":"validateUrl","value":"www.youtube.com/watch?v=x"},"expected":{"valid":false}},
    {"name":"validateUrl: a protocol-relative link is rejected","input":{"op":"validateUrl","value":"//example.com/a"},"expected":{"valid":false}},
    {"name":"validateUrl: a websocket link is rejected","input":{"op":"validateUrl","value":"ws://example.com/"},"expected":{"valid":false}},
    {"name":"validateUrl: an IPv6 host is accepted","input":{"op":"validateUrl","value":"https://[::1]/a"},"expected":{"valid":true,"href":"https://[::1]/a"}},
    {"name":"validateUrl: a hex IPv4 host is normalised","input":{"op":"validateUrl","value":"http://0x7f.1/a"},"expected":{"valid":true,"href":"http://127.0.0.1/a"}},
    {"name":"validateUrl: a line break in the middle is removed","input":{"op":"validateUrl","value":"https://example.com/a\nb"},"expected":{"valid":true,"href":"https://example.com/ab"}},
    {"name":"validateUrl: a tab and a line break around the link are removed","input":{"op":"validateUrl","value":"\thttps://example.com/a\n"},"expected":{"valid":true,"href":"https://example.com/a"}},
    {"name":"validateUrl: a non-breaking space around the link is trimmed","input":{"op":"validateUrl","value":" https://example.com/a "},"expected":{"valid":true,"href":"https://example.com/a"}},
    {"name":"validateUrl: dot segments are resolved","input":{"op":"validateUrl","value":"https://example.com/a/../b"},"expected":{"valid":true,"href":"https://example.com/b"}},
    {"name":"validateUrl: a fragment is kept","input":{"op":"validateUrl","value":"https://example.com/a#t=10"},"expected":{"valid":true,"href":"https://example.com/a#t=10"}},
    {"name":"validateUrl: mailto is rejected","input":{"op":"validateUrl","value":"mailto:a@b.c"},"expected":{"valid":false}},
    {"name":"validateUrl: a spotify uri is rejected","input":{"op":"validateUrl","value":"spotify:track:abc"},"expected":{"valid":false}},
    {"name":"validateUrl: a link of exactly 4096 characters is accepted","input":{"op":"validateUrl","value":"https://example."},"expected":{"valid":true}},
    {"name":"validateUrl: a link of 4097 characters is rejected","input":{"op":"validateUrl","value":"https://example."},"expected":{"valid":false}}
  ]
}
