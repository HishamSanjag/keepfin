{
  "description": "Routing decisions on links with URL edge cases (upper-case parts, ports, user info, escapes, fragments, trailing dots, IDN, missing scheme). Expected values are the desktop behaviour before the shared core.",
  "cases": [
    {"name":"name: upper-case scheme and host","input":{"op":"name","url":"HTTPS://WWW.YOUTUBE.COM/watch?v=aqz-KE-bpKQ&list=PLabc"},"expected":"YouTube"},
