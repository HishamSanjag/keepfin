    {"name":"playlistUrl: upper-case scheme and host","input":{"op":"playlistUrl","url":"HTTPS://WWW.YOUTUBE.COM/watch?v=aqz-KE-bpKQ&list=PLabc"},"expected":"https://www.youtube.com/playlist?list=PLabc"},
    {"name":"videoId: upper-case scheme and host","input":{"op":"videoId","url":"HTTPS://WWW.YOUTUBE.COM/watch?v=aqz-KE-bpKQ&list=PLabc"},"expected":"aqz-KE-bpKQ"},
    {"name":"name: a port on a known host","input":{"op":"name","url":"https://www.youtube.com:443/watch?v=aqz-KE-bpKQ"},"expected":"YouTube"},
    {"name":"folder: a port on a known host","input":{"op":"folder","url":"https://www.youtube.com:443/watch?v=aqz-KE-bpKQ"},"expected":"YouTube"},
    {"name":"videoId: a port on a known host","input":{"op":"videoId","url":"https://www.youtube.com:443/watch?v=aqz-KE-bpKQ"},"expected":"aqz-KE-bpKQ"},
    {"name":"name: a non-default port on a known host","input":{"op":"name","url":"https://www.youtube.com:8443/playlist?list=PLabc"},"expected":"YouTube"},
    {"name":"folder: a non-default port on a known host","input":{"op":"folder","url":"https://www.youtube.com:8443/playlist?list=PLabc"},"expected":"YouTube"},
    {"name":"collection: a non-default port on a known host","input":{"op":"collection","url":"https://www.youtube.com:8443/playlist?list=PLabc"},"expected":true},
    {"name":"name: user info before a known host","input":{"op":"name","url":"https://user@www.youtube.com/watch?v=aqz-KE-bpKQ"},"expected":"YouTube"},
    {"name":"folder: user info before a known host","input":{"op":"folder","url":"https://user@www.youtube.com/watch?v=aqz-KE-bpKQ"},"expected":"YouTube"},
    {"name":"videoId: user info before a known host","input":{"op":"videoId","url":"https://user@www.youtube.com/watch?v=aqz-KE-bpKQ"},"expected":"aqz-KE-bpKQ"},
