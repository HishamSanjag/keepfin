{
  "description": "URL parsing: the WHATWG URL Standard as implemented by `new URL` (the desktop behaviour; Android used java.net.URI before the shared core). `host` is null when the URL has no authority; `query` and `fragment` are null when empty (the href keeps an empty \"?\" or \"#\").",
  "cases": [
    {"name":"url: uppercase scheme and host are lower-cased","input":{"op":"url","value":"HTTPS://Example.COM/Path"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/Path","query":null,"fragment":null,"href":"https://example.com/Path"}},
    {"name":"url: the path keeps its case","input":{"op":"url","value":"https://EXAMPLE.com/Path/CASE"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/Path/CASE","query":null,"fragment":null,"href":"https://example.com/Path/CASE"}},
    {"name":"url: mixed-case scheme","input":{"op":"url","value":"HtTp://x.com/a"},"expected":{"scheme":"http","username":"","password":"","host":"x.com","port":null,"path":"/a","query":null,"fragment":null,"href":"http://x.com/a"}},
    {"name":"url: default https port is dropped","input":{"op":"url","value":"https://example.com:443/a"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/a","query":null,"fragment":null,"href":"https://example.com/a"}},
    {"name":"url: default http port is dropped","input":{"op":"url","value":"http://example.com:80/a"},"expected":{"scheme":"http","username":"","password":"","host":"example.com","port":null,"path":"/a","query":null,"fragment":null,"href":"http://example.com/a"}},
    {"name":"url: another port is kept","input":{"op":"url","value":"https://example.com:8080/a"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":8080,"path":"/a","query":null,"fragment":null,"href":"https://example.com:8080/a"}},
    {"name":"url: an empty port is dropped","input":{"op":"url","value":"https://example.com:/a"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/a","query":null,"fragment":null,"href":"https://example.com/a"}},
    {"name":"url: a port with leading zeros","input":{"op":"url","value":"https://example.com:0443/a"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/a","query":null,"fragment":null,"href":"https://example.com/a"}},
    {"name":"url: port zero is kept","input":{"op":"url","value":"https://example.com:0/a"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":0,"path":"/a","query":null,"fragment":null,"href":"https://example.com:0/a"}},
    {"name":"url: a port above 65535 is invalid","input":{"op":"url","value":"https://example.com:99999/a"},"expected":null},
    {"name":"url: a port that is not a number is invalid","input":{"op":"url","value":"https://a.com:abc/"},"expected":null},
    {"name":"url: a host with a port and no path","input":{"op":"url","value":"https://x.com:8080"},"expected":{"scheme":"https","username":"","password":"","host":"x.com","port":8080,"path":"/","query":null,"fragment":null,"href":"https://x.com:8080/"}},
    {"name":"url: user name in the link","input":{"op":"url","value":"https://user@example.com/a"},"expected":{"scheme":"https","username":"user","password":"","host":"example.com","port":null,"path":"/a","query":null,"fragment":null,"href":"https://user@example.com/a"}},
    {"name":"url: user name and password in the link","input":{"op":"url","value":"https://user:pw@example.com/a"},"expected":{"scheme":"https","username":"user","password":"pw","host":"example.com","port":null,"path":"/a","query":null,"fragment":null,"href":"https://user:pw@example.com/a"}},
    {"name":"url: an empty user info is dropped","input":{"op":"url","value":"https://@example.com/a"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/a","query":null,"fragment":null,"href":"https://example.com/a"}},
    {"name":"url: a user name with an empty password","input":{"op":"url","value":"https://user:@a.com/"},"expected":{"scheme":"https","username":"user","password":"","host":"a.com","port":null,"path":"/","query":null,"fragment":null,"href":"https://user@a.com/"}},
    {"name":"url: an at sign inside the user info is encoded","input":{"op":"url","value":"https://a@b@c.com/"},"expected":{"scheme":"https","username":"a%40b","password":"","host":"c.com","port":null,"path":"/","query":null,"fragment":null,"href":"https://a%40b@c.com/"}},
    {"name":"url: user info with nothing after it is invalid","input":{"op":"url","value":"https://user@/a"},"expected":null},
    {"name":"url: an IDN host becomes punycode","input":{"op":"url","value":"https://bücher.example/a"},"expected":{"scheme":"https","username":"","password":"","host":"xn--bcher-kva.example","port":null,"path":"/a","query":null,"fragment":null,"href":"https://xn--bcher-kva.example/a"}},
    {"name":"url: an upper-case IDN host is lower-cased first","input":{"op":"url","value":"https://BÜCHER.example/a"},"expected":{"scheme":"https","username":"","password":"","host":"xn--bcher-kva.example","port":null,"path":"/a","query":null,"fragment":null,"href":"https://xn--bcher-kva.example/a"}},
    {"name":"url: sharp s stays in the label (non-transitional)","input":{"op":"url","value":"https://faß.de/"},"expected":{"scheme":"https","username":"","password":"","host":"xn--fa-hia.de","port":null,"path":"/","query":null,"fragment":null,"href":"https://xn--fa-hia.de/"}},
    {"name":"url: a Japanese host","input":{"op":"url","value":"https://例え.jp/x"},"expected":{"scheme":"https","username":"","password":"","host":"xn--r8jz45g.jp","port":null,"path":"/x","query":null,"fragment":null,"href":"https://xn--r8jz45g.jp/x"}},
    {"name":"url: a punycode host is kept","input":{"op":"url","value":"https://xn--bcher-kva.example/"},"expected":{"scheme":"https","username":"","password":"","host":"xn--bcher-kva.example","port":null,"path":"/","query":null,"fragment":null,"href":"https://xn--bcher-kva.example/"}},
    {"name":"url: an invalid punycode label is rejected","input":{"op":"url","value":"https://xn--a/"},"expected":null},
    {"name":"url: a bare xn-- label is rejected","input":{"op":"url","value":"https://xn--/a"},"expected":null},
    {"name":"url: a fullwidth letter in the host is mapped","input":{"op":"url","value":"https://Ａ.com/"},"expected":{"scheme":"https","username":"","password":"","host":"a.com","port":null,"path":"/","query":null,"fragment":null,"href":"https://a.com/"}},
    {"name":"url: an ideographic full stop separates labels","input":{"op":"url","value":"https://example.com。cn/"},"expected":{"scheme":"https","username":"","password":"","host":"example.com.cn","port":null,"path":"/","query":null,"fragment":null,"href":"https://example.com.cn/"}},
    {"name":"url: a soft hyphen in a host is ignored","input":{"op":"url","value":"https://a­.com/"},"expected":{"scheme":"https","username":"","password":"","host":"a.com","port":null,"path":"/","query":null,"fragment":null,"href":"https://a.com/"}},
    {"name":"url: a dotted capital I","input":{"op":"url","value":"https://İ.com/"},"expected":{"scheme":"https","username":"","password":"","host":"xn--i-9bb.com","port":null,"path":"/","query":null,"fragment":null,"href":"https://xn--i-9bb.com/"}},
    {"name":"url: an emoji host","input":{"op":"url","value":"https://😀.com/"},"expected":{"scheme":"https","username":"","password":"","host":"xn--e28h.com","port":null,"path":"/","query":null,"fragment":null,"href":"https://xn--e28h.com/"}},
    {"name":"url: a Greek capital sigma at the end of a label is lower-cased without context","input":{"op":"url","value":"https://ΒΌΛΟΣ.gr/"},"expected":{"scheme":"https","username":"","password":"","host":"xn--nxasmq6b.gr","port":null,"path":"/","query":null,"fragment":null,"href":"https://xn--nxasmq6b.gr/"}},
    {"name":"url: a Cyrillic host in capitals","input":{"op":"url","value":"https://ПРИМЕР.рф/путь"},"expected":{"scheme":"https","username":"","password":"","host":"xn--e1afmkfd.xn--p1ai","port":null,"path":"/%D0%BF%D1%83%D1%82%D1%8C","query":null,"fragment":null,"href":"https://xn--e1afmkfd.xn--p1ai/%D0%BF%D1%83%D1%82%D1%8C"}},
    {"name":"url: a mixed ASCII and IDN label","input":{"op":"url","value":"https://shop-ü.example/"},"expected":{"scheme":"https","username":"","password":"","host":"xn--shop--ova.example","port":null,"path":"/","query":null,"fragment":null,"href":"https://xn--shop--ova.example/"}},
    {"name":"url: a compatibility character (superscript) in the host","input":{"op":"url","value":"https://a²b.com/"},"expected":{"scheme":"https","username":"","password":"","host":"a2b.com","port":null,"path":"/","query":null,"fragment":null,"href":"https://a2b.com/"}},
    {"name":"url: spaces in the path are encoded","input":{"op":"url","value":"https://example.com/a b"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/a%20b","query":null,"fragment":null,"href":"https://example.com/a%20b"}},
    {"name":"url: a percent escape stays as it is","input":{"op":"url","value":"https://example.com/a%20b"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/a%20b","query":null,"fragment":null,"href":"https://example.com/a%20b"}},
    {"name":"url: an encoded slash stays encoded","input":{"op":"url","value":"https://example.com/a%2fb"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/a%2fb","query":null,"fragment":null,"href":"https://example.com/a%2fb"}},
    {"name":"url: non-ASCII in the path is encoded as UTF-8","input":{"op":"url","value":"https://example.com/ä"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/%C3%A4","query":null,"fragment":null,"href":"https://example.com/%C3%A4"}},
    {"name":"url: characters the path set encodes","input":{"op":"url","value":"https://example.com/a\"b<c>d`e{f}g|h^i"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/a%22b%3Cc%3Ed%60e%7Bf%7Dg|h%5Ei","query":null,"fragment":null,"href":"https://example.com/a%22b%3Cc%3Ed%60e%7Bf%7Dg|h%5Ei"}},
    {"name":"url: a lone percent sign stays","input":{"op":"url","value":"https://example.com/%"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/%","query":null,"fragment":null,"href":"https://example.com/%"}},
    {"name":"url: an invalid percent escape stays","input":{"op":"url","value":"https://example.com/%zz"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/%zz","query":null,"fragment":null,"href":"https://example.com/%zz"}},
    {"name":"url: dot segments are resolved","input":{"op":"url","value":"https://example.com/./a/../b"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/b","query":null,"fragment":null,"href":"https://example.com/b"}},
    {"name":"url: encoded dot segments are resolved","input":{"op":"url","value":"https://example.com/a/%2e%2e/b"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/b","query":null,"fragment":null,"href":"https://example.com/b"}},
    {"name":"url: an empty segment is kept","input":{"op":"url","value":"https://example.com//a"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"//a","query":null,"fragment":null,"href":"https://example.com//a"}},
    {"name":"url: a trailing slash is kept","input":{"op":"url","value":"https://example.com/a/"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/a/","query":null,"fragment":null,"href":"https://example.com/a/"}},
    {"name":"url: a backslash in the path is a slash","input":{"op":"url","value":"https://example.com/a\\b"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/a/b","query":null,"fragment":null,"href":"https://example.com/a/b"}},
    {"name":"url: a backslash after the host starts the path","input":{"op":"url","value":"https://example.com\\a"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/a","query":null,"fragment":null,"href":"https://example.com/a"}},
    {"name":"url: a missing path becomes a slash","input":{"op":"url","value":"https://example.com"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/","query":null,"fragment":null,"href":"https://example.com/"}},
    {"name":"url: a query without a path","input":{"op":"url","value":"https://x.com?a=b"},"expected":{"scheme":"https","username":"","password":"","host":"x.com","port":null,"path":"/","query":"a=b","fragment":null,"href":"https://x.com/?a=b"}},
    {"name":"url: a fragment without a path","input":{"op":"url","value":"https://x.com#a"},"expected":{"scheme":"https","username":"","password":"","host":"x.com","port":null,"path":"/","query":null,"fragment":"a","href":"https://x.com/#a"}},
    {"name":"url: spaces in the query are encoded","input":{"op":"url","value":"https://example.com/a?q=a b"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/a","query":"q=a%20b","fragment":null,"href":"https://example.com/a?q=a%20b"}},
    {"name":"url: a plus in the query stays a plus","input":{"op":"url","value":"https://example.com/a?q=a+b&r=%E4%BD%A0"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/a","query":"q=a+b&r=%E4%BD%A0","fragment":null,"href":"https://example.com/a?q=a+b&r=%E4%BD%A0"}},
    {"name":"url: an invalid escape in the query stays","input":{"op":"url","value":"https://example.com/a?q=a%zzb"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/a","query":"q=a%zzb","fragment":null,"href":"https://example.com/a?q=a%zzb"}},
