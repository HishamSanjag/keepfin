    {"name":"url: empty query pieces","input":{"op":"url","value":"https://example.com/a?=&&x"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/a","query":"=&&x","fragment":null,"href":"https://example.com/a?=&&x"}},
    {"name":"url: a trailing dot on the host is kept","input":{"op":"url","value":"https://example.com./a"},"expected":{"scheme":"https","username":"","password":"","host":"example.com.","port":null,"path":"/a","query":null,"fragment":null,"href":"https://example.com./a"}},
    {"name":"url: two trailing dots","input":{"op":"url","value":"https://example.com../a"},"expected":{"scheme":"https","username":"","password":"","host":"example.com..","port":null,"path":"/a","query":null,"fragment":null,"href":"https://example.com../a"}},
