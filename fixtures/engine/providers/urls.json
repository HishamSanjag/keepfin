    {"name":"url: non-ASCII in the query and fragment","input":{"op":"url","value":"https://example.com/é?é=é#é"},"expected":{"scheme":"https","username":"","password":"","host":"example.com","port":null,"path":"/%C3%A9","query":"%C3%A9=%C3%A9","fragment":"%C3%A9","href":"https://example.com/%C3%A9?%C3%A9=%C3%A9#%C3%A9"}},
