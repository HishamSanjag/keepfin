{
  "description": "Whether What's new is due: the running version is newer than the last version whose notes were seen. A fresh install (nothing stored), the same version and downgrades show nothing; the way the new version was installed never matters.",
  "cases": [
    {"name":"fresh install shows nothing","input":{"op":"whatsNewDue","seen":null,"current":"1.1.0"},"expected":false},
    {"name":"same version shows nothing","input":{"op":"whatsNewDue","seen":"1.1.0","current":"1.1.0"},"expected":false},
    {"name":"an update shows it","input":{"op":"whatsNewDue","seen":"1.0.2","current":"1.1.0"},"expected":true},
    {"name":"a beta to its final release shows it","input":{"op":"whatsNewDue","seen":"1.1.0-beta.4","current":"1.1.0"},"expected":true},
    {"name":"a beta to a later beta shows it","input":{"op":"whatsNewDue","seen":"1.1.0-beta.3","current":"1.1.0-beta.4"},"expected":true},
    {"name":"a downgrade shows nothing","input":{"op":"whatsNewDue","seen":"1.1.0","current":"1.0.2"},"expected":false},
    {"name":"a final to its own beta shows nothing","input":{"op":"whatsNewDue","seen":"1.1.0","current":"1.1.0-beta.4"},"expected":false},
    {"name":"unreadable stored text shows nothing","input":{"op":"whatsNewDue","seen":"garbage","current":"1.1.0"},"expected":false}
  ]
}
