{
  "description": "Source recording -> the ordered list of searches a platform must run: the YouTube Music songs API, then the YouTube Music flat search, then the YouTube flat search.",
  "cases": [
    {"name":"a plain track searches songs, YouTube Music and YouTube in that order","input":{"op":"searches","track":{"title":"One More Time","artists":["Daft Punk"]}},"expected":[{"kind":"songsApi","query":"Daft Punk One More Time"},{"kind":"flat","target":"https://music.youtube.com/search?q=Daft%20Punk%20One%20More%20Time#songs","origin":"ytm-flat","playlistEnd":8},{"kind":"flat","target":"ytsearch5:Daft Punk One More Time","origin":"youtube","playlistEnd":8}]},
    {"name":"only the first two artists and the title without feat credits are searched","input":{"op":"searches","track":{"title":"Get Lucky (feat. Pharrell Williams)","artists":["Daft Punk","Pharrell Williams","Nile Rodgers"]}},"expected":[{"kind":"songsApi","query":"Daft Punk Pharrell Williams Get Lucky"},{"kind":"flat","target":"https://music.youtube.com/search?q=Daft%20Punk%20Pharrell%20Williams%20Get%20Lucky#songs","origin":"ytm-flat","playlistEnd":8},{"kind":"flat","target":"ytsearch5:Daft Punk Pharrell Williams Get Lucky","origin":"youtube","playlistEnd":8}]},
    {"name":"non-ASCII text is percent-encoded as UTF-8 in the YouTube Music link and kept as is elsewhere","input":{"op":"searches","track":{"title":"日本語の歌","artists":["Beyoncé"]}},"expected":[{"kind":"songsApi","query":"Beyoncé 日本語の歌"},{"kind":"flat","target":"https://music.youtube.com/search?q=Beyonc%C3%A9%20%E6%97%A5%E6%9C%AC%E8%AA%9E%E3%81%AE%E6%AD%8C#songs","origin":"ytm-flat","playlistEnd":8},{"kind":"flat","target":"ytsearch5:Beyoncé 日本語の歌","origin":"youtube","playlistEnd":8}]},
    {"name":"characters that need escaping in the link","input":{"op":"searches","track":{"title":"Rock & Roll? #1 / A+B 'Live'","artists":["AC/DC"]}},"expected":[{"kind":"songsApi","query":"AC/DC Rock & Roll? #1 / A+B 'Live'"},{"kind":"flat","target":"https://music.youtube.com/search?q=AC%2FDC%20Rock%20%26%20Roll%3F%20%231%20%2F%20A%2BB%20'Live'#songs","origin":"ytm-flat","playlistEnd":8},{"kind":"flat","target":"ytsearch5:AC/DC Rock & Roll? #1 / A+B 'Live'","origin":"youtube","playlistEnd":8}]},
    {"name":"unreserved punctuation stays unescaped","input":{"op":"searches","track":{"title":"Hello! (World) *~_.-","artists":["Artist"]}},"expected":[{"kind":"songsApi","query":"Artist Hello! (World) *~_.-"},{"kind":"flat","target":"https://music.youtube.com/search?q=Artist%20Hello!%20(World)%20*~_.-#songs","origin":"ytm-flat","playlistEnd":8},{"kind":"flat","target":"ytsearch5:Artist Hello! (World) *~_.-","origin":"youtube","playlistEnd":8}]}
  ]
}
