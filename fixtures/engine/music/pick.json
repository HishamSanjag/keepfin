{
  "description": "The search-and-stop rule: each search returns candidates or \"fail\" (an error). Searches run in order and stop once the best confidence so far is >= 0.8. `searchesRun` counts attempted searches, failures included.",
  "cases": [
    {"name":"a confident first search stops the rest","input":{"op":"pick","track":{"title":"One More Time","artists":["Daft Punk"],"album":"Discovery","durationSec":320},"searches":[[{"id":"aaaaaaaaaaa","title":"One More Time","channel":"Daft Punk - Topic","durationSec":320,"origin":"ytm-song"}],[{"id":"mmmmmmmmmmC","title":"One More Time","channel":"Daft","durationSec":330}],[{"id":"mmmmmmmmmmC","title":"One More Time","channel":"Daft","durationSec":330}]]},"expected":{"bestId":"aaaaaaaaaaa","searchesRun":1}},
    {"name":"a weak first search continues; a confident second one stops","input":{"op":"pick","track":{"title":"One More Time","artists":["Daft Punk"],"album":"Discovery","durationSec":320},"searches":[[{"id":"wwwwwwwwwww","title":"Something Else Entirely","channel":"Nobody","durationSec":100}],[{"id":"aaaaaaaaaaa","title":"One More Time","channel":"Daft Punk - Topic","durationSec":320,"origin":"ytm-song"}],[{"id":"mmmmmmmmmmC","title":"One More Time","channel":"Daft","durationSec":330}]]},"expected":{"bestId":"aaaaaaaaaaa","searchesRun":2}},
    {"name":"when nothing is confident the best of all searches wins after running all three","input":{"op":"pick","track":{"title":"One More Time","artists":["Daft Punk"],"album":"Discovery","durationSec":320},"searches":[[{"id":"mmmmmmmmmmA","title":"Daft Punk - One More Time (Live)","channel":"Fan","durationSec":321}],[{"id":"mmmmmmmmmmC","title":"One More Time","channel":"Daft","durationSec":330}],[{"id":"wwwwwwwwwww","title":"Something Else Entirely","channel":"Nobody","durationSec":100}]]},"expected":{"bestId":"mmmmmmmmmmC","searchesRun":3}},
    {"name":"a failing search is skipped but still counted","input":{"op":"pick","track":{"title":"One More Time","artists":["Daft Punk"],"album":"Discovery","durationSec":320},"searches":["fail",[{"id":"aaaaaaaaaaa","title":"One More Time","channel":"Daft Punk - Topic","durationSec":320,"origin":"ytm-song"}],[{"id":"mmmmmmmmmmC","title":"One More Time","channel":"Daft","durationSec":330}]]},"expected":{"bestId":"aaaaaaaaaaa","searchesRun":2}},
    {"name":"all searches failing finds nothing","input":{"op":"pick","track":{"title":"One More Time","artists":["Daft Punk"],"album":"Discovery","durationSec":320},"searches":["fail","fail","fail"]},"expected":{"bestId":null,"searchesRun":3}},
    {"name":"equal confidence keeps the earlier result","input":{"op":"pick","track":{"title":"One More Time","artists":["Daft Punk"],"album":"Discovery","durationSec":320},"searches":[[{"id":"mmmmmmmmmmA","title":"Daft Punk - One More Time (Live)","channel":"Fan","durationSec":321}],[{"id":"mmmmmmmmmmB","title":"Daft Punk - One More Time (Live)","channel":"Fan","durationSec":321}],[]]},"expected":{"bestId":"mmmmmmmmmmA","searchesRun":3}},
    {"name":"a weaker later result does not replace an earlier one","input":{"op":"pick","track":{"title":"One More Time","artists":["Daft Punk"],"album":"Discovery","durationSec":320},"searches":[[{"id":"mmmmmmmmmmC","title":"One More Time","channel":"Daft","durationSec":330}],[{"id":"mmmmmmmmmmA","title":"Daft Punk - One More Time (Live)","channel":"Fan","durationSec":321}],[]]},"expected":{"bestId":"mmmmmmmmmmC","searchesRun":3}},
    {"name":"results below the minimum confidence are ignored, so nothing is found","input":{"op":"pick","track":{"title":"One More Time","artists":["Daft Punk"],"album":"Discovery","durationSec":320},"searches":[[{"id":"wwwwwwwwwww","title":"Something Else Entirely","channel":"Nobody","durationSec":100}],[],[{"id":"wwwwwwwwwww","title":"Something Else Entirely","channel":"Nobody","durationSec":100}]]},"expected":{"bestId":null,"searchesRun":3}},
    {"name":"the best candidate within one search wins even when it is not first","input":{"op":"pick","track":{"title":"One More Time","artists":["Daft Punk"],"album":"Discovery","durationSec":320},"searches":[[{"id":"mmmmmmmmmmA","title":"Daft Punk - One More Time (Live)","channel":"Fan","durationSec":321},{"id":"aaaaaaaaaaa","title":"One More Time","channel":"Daft Punk - Topic","durationSec":320,"origin":"ytm-song"}],[{"id":"mmmmmmmmmmC","title":"One More Time","channel":"Daft","durationSec":330}]]},"expected":{"bestId":"aaaaaaaaaaa","searchesRun":1}}
