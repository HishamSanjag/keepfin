{
  "name": "keepfin",
  "version": "1.1.0-beta.4",
  "description": "Keepfin: a desktop and Android companion for saving the media you choose",
  "productName": "Keepfin",
  "type": "module",
  "main": "build/desktop/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node scripts/dev/install-hooks.mjs",
    "hooks:install": "node scripts/dev/install-hooks.mjs",
    "build": "npm run gui:build",
    "dev": "npm run gui:dev",
    "test": "npm run gui:test",
    "typecheck": "npm run gui:typecheck",
    "start": "npm run desktop",
    "gui:dev": "npm run core:build && npm run icons:build && vite --config gui/vite.config.ts",
    "icons:build": "node scripts/build/build-icons.mjs && node scripts/build/build-installer-art.mjs",
    "installer:art": "node scripts/build/build-installer-art.mjs",
    "core:build": "node scripts/build/build-core.mjs",
    "core:test": "node scripts/test/test-core.mjs",
    "gui:build": "npm run core:build && npm run icons:build && vite build --config gui/vite.config.ts && tsup --config gui/tsup.config.ts",
    "gui:typecheck": "npm run core:build && tsc --noEmit -p gui/tsconfig.json",
    "gui:test": "npm run core:build && node scripts/test/run-tests.mjs",
    "test:slow": "npm run core:build && node scripts/test/run-tests.mjs --slow",
    "gui:real-test": "node scripts/test/smoke-real-workflow.mjs",
    "desktop": "npm run gui:build && electron .",
    "desktop:pack": "npm run gui:build && npm run tools:fetch && node scripts/build/stage-release-notes.mjs && electron-builder --dir",
    "desktop:build": "npm run gui:build && npm run tools:fetch && node scripts/build/stage-release-notes.mjs && electron-builder",
    "android:build": "npm run icons:build && npm run gallery:fetch && node scripts/build/android-build.mjs",
    "releases:organize": "node scripts/release/organize-releases.mjs",
    "engine:test": "npm run core:build && tsx scripts/test/smoke-engine.ts",
    "desktop:test": "node scripts/test/smoke-desktop.mjs",
    "library:test": "node scripts/test/library-smoke.mjs",
    "check": "npm run sizes && npm run check:boundaries && npm run check:apis && npm run check:links && npm run gui:typecheck && npm run gui:test && npm run gui:build",
    "tools:fetch": "node scripts/build/fetch-tools.mjs",
    "gallery:fetch": "node scripts/build/fetch-gallery-python.mjs",
    "gui:flows-test": "node scripts/test/smoke-ui-flows.mjs",
    "gui:progress-test": "node scripts/test/smoke-ui-progress.mjs",
    "gui:layout-test": "node scripts/test/smoke-ui-layout.mjs",
    "gui:ui-test": "npm run gui:flows-test && npm run gui:progress-test && npm run gui:layout-test",
    "readme:images": "node scripts/capture/readme-images.mjs",
    "dev:demo": "npm run core:build && npm run icons:build && node scripts/dev/dev-demo.mjs",
    "check:boundaries": "node scripts/check/check-boundaries.mjs",
    "check:apis": "node scripts/check/check-banned-apis.mjs",
    "check:links": "node scripts/check/check-links.mjs",
    "sizes": "node scripts/check/report-sizes.mjs"
  },
  "keywords": [
    "video",
    "downloader",
    "desktop",
    "electron",
    "android"
  ],
  "license": "MIT",
  "author": "Hisham Sanjag",
  "dependencies": {
    "@tanstack/react-virtual": "3.14.13",
    "bonjour-service": "^1.4.4",
    "builder-util-runtime": "^9.7.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "media-chrome": "4.19.2",
    "music-metadata": "11.16.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "electron": "^44.9.1",
    "electron-builder": "26.15.3",
    "prettier": "^3.9.9",
    "tsup": "^9.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "webdav-server": "^2.6.3"
  },
  "overrides": {
    "minimatch@^10.2.5": "^11.0.1",
    "minimatch@^9.0.3": "^11.0.1"
  },
  "private": true,
  "contributors": [
    {
      "name": "Pablo Stanley",
      "url": "https://github.com/pablostanley",
      "comment": "Inspiration for the original project"
    }
  ]
}
